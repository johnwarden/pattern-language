{
  "name": "pattern-language",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "test:language": "node --disable-warning=ExperimentalWarning src/test-cli.ts",
    "build": "node build.mjs",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
