        {
          "match": "(?<![\\p{L}\\p{N}_])(?:[a-z][A-Za-z0-9]*)(?![\\p{L}\\p{N}_])",
          "name": "variable.other.pattern-language"
        },
        {
          "match": "[$+*/=<>!&|^%~?@\\\\-]+",
          "name": "keyword.operator.pattern-language"
        },
        {
