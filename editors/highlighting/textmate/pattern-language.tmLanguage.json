        },
        {
          "match": "\\.\\.\\.|…",
          "name": "keyword.operator.rest.pattern-language"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(:)((?:(?:[A-Za-z][A-Za-z0-9]*|[A-Z]{1,2}_|[A-Z]{3,}[A-Z0-9]*|[A-Z][A-Z0-9]*(?:_[A-Z][A-Z0-9]*)+)|_(?:[0-9]+)?)(?![\\p{L}\\p{N}_])|\\[\\]|\\{\\}|[$+*/=<>!&|^%~?@\\\\-]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.symbol.pattern-language"
            },
            "2": {
              "name": "constant.other.symbol.pattern-language"
