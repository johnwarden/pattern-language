          "match": ":(?=\\()",
          "name": "punctuation.definition.quotation.pattern-language"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:0[fF][0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?|0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*(?:\\.[0-9a-fA-F](?:_?[0-9a-fA-F])*)?(?:[pP][+-]?[0-9](?:_?[0-9])*)?|0[bB][01](?:_?[01])*(?:\\.[01](?:_?[01])*)?(?:[pP][+-]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?)(?![\\p{L}\\p{N}_])",
          "name": "constant.numeric.pattern-language"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:def|type|macro)(?![\\p{L}\\p{N}_])",
          "name": "storage.type.pattern-language"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:if|else|match|end)(?![\\p{L}\\p{N}_])",
          "name": "keyword.control.pattern-language"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:test|expect|result|error|assert|todo|legacy)(?![\\p{L}\\p{N}_])",
          "name": "keyword.other.test.pattern-language"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:True|False)(?![\\p{L}\\p{N}_])",
          "name": "constant.language.pattern-language"
