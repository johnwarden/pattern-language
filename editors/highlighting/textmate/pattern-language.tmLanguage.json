    "comments": {
      "patterns": [
        {
          "match": "(#).*$",
          "name": "comment.line.number-sign.pattern-language",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.pattern-language"
            }
          }
        }
      ]
    },
    "atoms": {
      "patterns": [
        {
          "match": "(:)(::)",
          "captures": {
            "1": {
              "name": "punctuation.definition.symbol.pattern-language"
            },
            "2": {
              "name": "constant.other.symbol.pattern-language"
