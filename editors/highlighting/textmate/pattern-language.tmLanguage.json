        {
          "match": "(?<![\\p{L}\\p{N}_])(?:Any|Body|Bool|Expression|Float|Float32|Float64|Int|LowerCamelSymbol|PunctuationSymbol|Rational|String|Symbol|Type|UpperCamelSymbol|UpperSnakeSymbol)(?![\\p{L}\\p{N}_])",
          "name": "support.type.pattern-language"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:[a-z][A-Za-z0-9]*)(?![\\p{L}\\p{N}_])(?=:(?!:))",
          "name": "entity.name.tag.pattern-language"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:(?:[A-Z]{1,2}_|[A-Z]{3,}[A-Z0-9]*|[A-Z][A-Z0-9]*(?:_[A-Z][A-Z0-9]*)+))(?![\\p{L}\\p{N}_])",
          "name": "constant.other.symbol.upper-snake.pattern-language"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:[A-Z][A-Za-z0-9]*)(?![\\p{L}\\p{N}_])",
          "name": "entity.name.type.pattern-language"
