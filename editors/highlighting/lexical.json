{
  "name": "Pattern Language",
  "id": "pattern-language",
  "scope": "source.pattern-language",
  "extensions": ["pattern", "test"],
  "declarations": ["def", "type", "macro"],
  "control": ["if", "else", "match", "end"],
  "testDsl": ["test", "expect", "result", "error", "assert", "todo", "legacy"],
  "constants": ["True", "False"],
  "intrinsicTypes": ["Any", "Body", "Bool", "Expression", "Float", "Float32", "Float64", "Int", "LowerCamelSymbol", "PunctuationSymbol", "Rational", "String", "Symbol", "Type", "UpperCamelSymbol", "UpperSnakeSymbol"],
  "patterns": {
    "upperSnake": "(?:[A-Z]{1,2}_|[A-Z]{3,}[A-Z0-9]*|[A-Z][A-Z0-9]*(?:_[A-Z][A-Z0-9]*)+)",
    "identifier": "(?:[A-Za-z][A-Za-z0-9]*|[A-Z]{1,2}_|[A-Z]{3,}[A-Z0-9]*|[A-Z][A-Z0-9]*(?:_[A-Z][A-Z0-9]*)+)",
    "wildcard": "_(?:[0-9]+)?",
    "decimal": "[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?",
    "hex": "0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*(?:\\.[0-9a-fA-F](?:_?[0-9a-fA-F])*)?(?:[pP][+-]?[0-9](?:_?[0-9])*)?",
    "binary": "0[bB][01](?:_?[01])*(?:\\.[01](?:_?[01])*)?(?:[pP][+-]?[0-9](?:_?[0-9])*)?",
    "operators": "[$+*/=<>!&|^%~?@\\\\-]+",
    "postfixCharacters": "[~!@$%^&*?]"
  }
}
