{
  "name": "Pattern Language",
  "id": "pattern-language",
  "scope": "source.pattern-language",
  "extensions": ["pattern", "test"],
  "declarations": ["def", "type", "macro", "struct", "pattern", "abstract", "concrete", "unionType"],
  "control": ["if", "else", "match", "end"],
  "testDsl": ["test", "expect", "is", "fails", "contains", "assert", "todo", "legacy"],
  "constants": ["True", "False"],
  "intrinsicTypes": ["Any", "Body", "Bool", "Code", "Expression", "Float", "Float32", "Float64", "Int", "LowerCamelSymbol", "PunctuationSymbol", "NumericValue", "ReservedSymbol", "String", "Symbol", "Type", "UpperCamelSymbol", "UpperSnakeSymbol"],
  "patterns": {
    "upperSnake": "(?:[A-Z]{1,2}_|[A-Z]{3,}[A-Z0-9]*|[A-Z][A-Z0-9]*(?:_[A-Z][A-Z0-9]*)+)",
    "identifier": "(?:[A-Za-z][A-Za-z0-9]*|[A-Z]{1,2}_|[A-Z]{3,}[A-Z0-9]*|[A-Z][A-Z0-9]*(?:_[A-Z][A-Z0-9]*)+)",
    "wildcard": "_(?:[0-9]+)?",
    "operators": "[$+*/=<>!&|^%~?@\\\\-]+",
    "postfixCharacters": "[~!@$%^&*?]"
  }
}
