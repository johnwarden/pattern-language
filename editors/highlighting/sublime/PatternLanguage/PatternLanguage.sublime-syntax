    - meta_scope: meta.embedded.expression.pattern-language
    - match: \)
      scope: punctuation.section.interpolation.end.pattern-language
      pop: true
    - include: main
  template-code:
    - include: holes
    - include: template-groups
    - include: main
  blocks:
