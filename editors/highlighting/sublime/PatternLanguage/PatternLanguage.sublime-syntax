      scope: punctuation.section.parens.begin.pattern-language
      push: template-parens
    - match: \[
      scope: punctuation.section.brackets.begin.pattern-language
      push: template-brackets
    - match: \{
      scope: punctuation.section.braces.begin.pattern-language
