      scope: constant.numeric.pattern-language
    - match: (?<![\p{L}\p{N}_])(?:def|type|macro)(?![\p{L}\p{N}_])
      scope: storage.type.pattern-language
    - match: (?<![\p{L}\p{N}_])(?:if|else|match|end)(?![\p{L}\p{N}_])
      scope: keyword.control.pattern-language
    - match: (?<![\p{L}\p{N}_])(?:test|expect|is|fails|contains|assert|todo|legacy)(?![\p{L}\p{N}_])
      scope: keyword.other.test.pattern-language
    - match: (?<![\p{L}\p{N}_])(?:True|False)(?![\p{L}\p{N}_])
      scope: constant.language.pattern-language
    - match: (?<![\p{L}\p{N}_])(?:Any|Body|Bool|Expression|Float|Float32|Float64|Int|LowerCamelSymbol|PunctuationSymbol|Rational|String|Symbol|Type|UpperCamelSymbol|UpperSnakeSymbol)(?![\p{L}\p{N}_])
      scope: support.type.pattern-language
    - match: (?<![\p{L}\p{N}_])(?:[a-z][A-Za-z0-9]*)(?![\p{L}\p{N}_])(?=:(?!:))
      scope: entity.name.tag.pattern-language
    - match: (?<![\p{L}\p{N}_])(?:(?:[A-Z]{1,2}_|[A-Z]{3,}[A-Z0-9]*|[A-Z][A-Z0-9]*(?:_[A-Z][A-Z0-9]*)+))(?![\p{L}\p{N}_])
      scope: constant.other.symbol.upper-snake.pattern-language
    - match: (?<![\p{L}\p{N}_])(?:[A-Z][A-Za-z0-9]*)(?![\p{L}\p{N}_])(?=\()
      scope: constant.other.symbol.constructor.pattern-language
    - match: (?<![\p{L}\p{N}_])(?:[A-Z][A-Za-z0-9]*)(?![\p{L}\p{N}_])
      scope: entity.name.type.pattern-language
    - match: (?<![\p{L}\p{N}_])(?:_(?:[0-9]+)?)(?![\p{L}\p{N}_])
      scope: variable.language.wildcard.pattern-language
    - match: (?<![\p{L}\p{N}_])(?:[a-z][A-Za-z0-9]*)(?![\p{L}\p{N}_])
      scope: variable.other.pattern-language
    - match: "[$+*/=<>!&|^%~?@\\\\-]+"
      scope: keyword.operator.pattern-language
    - match: "[.,:]"
      scope: punctuation.separator.pattern-language
  escapes:
    - match: \\(?:[nrtvbf0"\\]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})
      scope: constant.character.escape.pattern-language
