      captures:
        "1": entity.name.function.reader.pattern-language
        "2": punctuation.definition.string.begin.pattern-language
      push: raw-reader-interpolated
    - match: ((?<![\p{L}\p{N}_])(?:(?:[A-Za-z][A-Za-z0-9]*|[A-Z]{1,2}_|[A-Z]{3,}[A-Z0-9]*|[A-Z][A-Z0-9]*(?:_[A-Z][A-Z0-9]*)+))(?![\p{L}\p{N}_]))(')
      captures:
        "1": entity.name.function.reader.pattern-language
        "2": punctuation.definition.string.begin.pattern-language
      push: raw-reader
    - match: (?<![\p{L}\p{N}_])(?:(?:[A-Za-z][A-Za-z0-9]*|[A-Z]{1,2}_|[A-Z]{3,}[A-Z0-9]*|[A-Z][A-Z0-9]*(?:_[A-Z][A-Z0-9]*)+))(?![\p{L}\p{N}_])(?=\$?")
      scope: entity.name.function.reader.pattern-language
  strings:
    - match: \$"
      scope: punctuation.definition.string.begin.pattern-language
      push: double-interpolated
    - match: \$'
      scope: punctuation.definition.string.begin.pattern-language
      push: single-interpolated
    - match: '"'
      scope: punctuation.definition.string.begin.pattern-language
      push: double
    - match: "'"
      scope: punctuation.definition.string.begin.pattern-language
      push: single
  typed-quotes:
    - match: ((?<![\p{L}\p{N}_])(?:(?:[A-Za-z][A-Za-z0-9]*|[A-Z]{1,2}_|[A-Z]{3,}[A-Z0-9]*|[A-Z][A-Z0-9]*(?:_[A-Z][A-Z0-9]*)+))(?![\p{L}\p{N}_]))(\$`)
