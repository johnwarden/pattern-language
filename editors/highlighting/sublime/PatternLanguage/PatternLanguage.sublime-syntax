        - block-double
        - open-double
    - match: ^([ \t]*)(?=(?:[^#"'\n]|"(?:\\[^\n]|[^"\\\n])*"|(?<![A-Za-z0-9_])(?<![A-Za-z0-9_]\$)'[^'\n]*')*?'\n)
