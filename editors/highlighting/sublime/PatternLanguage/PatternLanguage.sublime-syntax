name: Pattern Language
file_extensions:
  - pattern
  - test
scope: source.pattern-language
version: 2
contexts:
  main:
    - include: comments
    - include: blocks
    - include: inline-code
  comments:
    - match: (#).*$
      scope: comment.line.number-sign.pattern-language
      captures:
        "1": punctuation.definition.comment.pattern-language
  inline-code:
    - include: comments
    - include: readers
    - include: strings
    - include: typed-quotes
    - include: groups
    - include: atoms
  atoms:
    - match: (:)(::)
