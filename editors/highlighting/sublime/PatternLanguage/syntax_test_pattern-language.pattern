# raw strings are literal while double quotes decode escapes
raw = 'literal \n $name # text'
#              ^^ string.quoted.single - constant.character.escape
#                 ^^^^^ string.quoted.single - variable.other.interpolation - punctuation.definition.interpolation - comment
#                       ^^^^^^ string.quoted.single - comment
