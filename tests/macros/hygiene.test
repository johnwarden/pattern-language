test "Inserted caller references stay separate from template lambda binders"
  macro :withTemp Args(x) Code$` (temp -> $(x))(99)
  temp = 7
  expect
    (withTemp Args(temp))
  result 7 :: Rational

  macro :twice Args(x) Code$` (temp -> temp + temp)($(x))
  expect
    (twice Args(5))
  result 10 :: Rational
end

test "Template free functions resolve in the macro definition scope"
  def helper(x) x + 1
  macro :wrap Args(x) Code$` helper($(x))
  def f(x)
    helper = x -> 99
    (wrap Args(x))
  end

  expect f(4) result 5 :: Rational
end

test "Template block bindings preserve caller references"
  macro :withTemp Args(x)
    Code$` (
      (temp = 99)
      (temp + $(x))
    )
  end
  temp = 7

  expect
    (withTemp Args(temp))
  result 106 :: Rational
end

test "Template lambda labels retain defaulted captures"
  macro :make Args(x) Code` (size: Int = 3) -> size
  f = (make Args(1))

  expect f() result 3 :: Int
end

test "Macro templates retain locally declared sidefix grammars"
  def f()
    macro :answer x :: Expression Code$` $(x)
    macro :wrap Args(x) Code$` answer $(x)
    (wrap Args(7))
  end

  expect f() result 7 :: Rational
end

test "Macro expansion supports definitions in a generated local block"
  macro :make Args() Code` (
    def f(x) x
    (f(1))
  )

  expect
    (make Args())
  result 1 :: Rational
end

test "Registered ordinary builders retain hygienic helper references"
  def helper(x) x + 1
  def build(e) Code$` helper($(e))
  macro :wrapped Args(e)
    build(e)
  end
  def f(x)
    helper = x -> 99
    (wrapped Args(x))
  end

  expect f(4) result 5 :: Rational
end
