test "ASCII word symbol classes"
  expect :a is a :: LowerCamelSymbol
  expect :ab is ab :: LowerCamelSymbol
  expect :aB is aB :: LowerCamelSymbol
  expect :aBc is aBc :: LowerCamelSymbol
  expect :abC is abC :: LowerCamelSymbol
  expect :abCd is abCd :: LowerCamelSymbol
  expect :A is A :: UpperCamelSymbol
  expect :Ab is Ab :: UpperCamelSymbol
  expect :AB is AB :: UpperCamelSymbol
  expect :ABc is ABc :: UpperCamelSymbol
  expect :AbC is AbC :: UpperCamelSymbol
  expect :AbCd is AbCd :: UpperCamelSymbol
  expect :A_ is A_ :: UpperSnakeSymbol
  expect :AB_ is AB_ :: UpperSnakeSymbol
  expect :A_B is A_B :: UpperSnakeSymbol
  expect :A_BC is A_BC :: UpperSnakeSymbol
  expect :AB_C is AB_C :: UpperSnakeSymbol
  expect :AB_CD is AB_CD :: UpperSnakeSymbol

  expect :PORT is PORT :: UpperSnakeSymbol
  expect :ERR_FILE_NOT_FOUND is ERR_FILE_NOT_FOUND :: UpperSnakeSymbol
end

test "ReservedSymbol is disjoint from ordinary symbol classes"
  expect :Symbol is Symbol :: UpperCamelSymbol
  expect :Number is Number :: UpperCamelSymbol
  assert not(Int64 .matches UpperCamelSymbol)
  assert Int64 .matches ReservedSymbol
  assert not(True .matches UpperCamelSymbol)
  assert not(True .matches ReservedSymbol)
  assert :Widget .matches Symbol
  assert not(Int64 .matches Symbol)
  assert Int === Int64
  assert not(Int .matches ReservedSymbol)
end
