test "Interpolation and literal dollars"
  name = "Jo"
  raw = "Hello, $name"
  expanded = $"Hello, $(name); $(2 + 3)"

  expect raw result "Hello, $name" :: String
  expect expanded result "Hello, Jo; 5" :: String
  (raw, expanded)
end

test "Quoted expression values"
  def f(x) 2 * x
  b = :f(1)
  c = :(f(1))

  assert b == c
  legacy expect b result f(1) :: Expression

  ((b == c), b)
end

test "Raw and interpolated typed Code"
  name = "Jo"

  quoted = Code` hello($name)
  interpolated = Code$` hello($name)

  expect quoted result hello($(name)) :: Code
  expect interpolated result hello("Jo") :: Code
  assert parse(Code)(toString(Code)(interpolated)) == interpolated
  (quoted, interpolated)
end

test "Reader interpolation"
  def Html type {fragments: [_... :: String*], values: [_... :: String*]}
  def html(fragments :: [_... :: String*], values :: [_... :: String*]) {fragments: fragments, values: values} :: Html
  name = "<strong>Jo</strong>"

  expect html$"<p>Hello, $(name)</p>" result {fragments: ["<p>Hello, ", "</p>"], values: ["<strong>Jo</strong>"]} :: Html
end

test "Raw, escaped and explicitly interpolated strings"
  name = 'Jo'

  expect 'Hello, $name' result "Hello, $name" :: String
  expect "Hello, $name" result "Hello, $name" :: String
  expect $'Hello, $name' result "Hello, Jo" :: String
  expect "one\ntwo" result "one\ntwo" :: String
  expect $'Hello, $$name' result "Hello, $name" :: String
  ('Hello, $name', "Hello, $name", $'Hello, $name', "one\ntwo", $'Hello, $$name')
end

test "Typed expression quotes"
  x = 2
  raw = Code` x ^ 2
  expanded = Code$` $x ^ 2

  expect raw result
    (x ^ 2) :: Code
  end
  expect expanded result
    (2 ^ 2) :: Code
  end
  (raw, expanded)
end

test "Typed parse / toString round-trip"
  def Rectangle type :Rect(width :: Number, height :: Number)
  value = Rect(3, 4) :: Rectangle
  text = toString(Rectangle)(value)

  expect text result "Rect(3, 4)" :: String

  assert parse(Rectangle)(text) == value

  (text, (parse(Rectangle)(text) == value))
end
