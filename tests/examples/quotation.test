test "Interpolation and literal dollars"
  name = "Jo"
  raw = "Hello, $name"
  expanded = $"Hello, $(name); $(2 + 3)"

  expect raw is "Hello, $name" :: String
  expect expanded is "Hello, Jo; 5" :: String
  (raw, expanded)
end

test "Quoted expression values"
  def f(x) 2 * x
  c = :(f(1))

  expect c is f(1) :: Expression

  (c, c == :(f(1)))
end

test "A quoted head is not a data constructor"
  expect :f(1) fails "E_NOT_CALLABLE"
end

test "Raw and interpolated typed Code"
  name = "Jo"

  quoted = Code` hello($name)
  interpolated = Code$` hello($name)

  expect quoted is hello($(name)) :: Code
  expect interpolated is hello("Jo") :: Code
  assert parse(Code)(toString(Code)(interpolated)) == interpolated
  (quoted, interpolated)
end

test "Reader interpolation"
  def Html type {fragments: [_... :: String*], values: [_... :: String*]}
  def html(fragments :: [_... :: String*], values :: [_... :: String*]) {fragments: fragments, values: values} :: Html
  name = "<strong>Jo</strong>"

  expect html$"<p>Hello, $(name)</p>" is {fragments: ["<p>Hello, ", "</p>"], values: ["<strong>Jo</strong>"]} :: Html
end

test "Raw, escaped and explicitly interpolated strings"
  name = 'Jo'

  expect 'Hello, $name' is "Hello, $name" :: String
  expect "Hello, $name" is "Hello, $name" :: String
  expect $'Hello, $name' is "Hello, Jo" :: String
  expect "one\ntwo" is "one\ntwo" :: String
  expect $'Hello, $$name' is "Hello, $name" :: String
  ('Hello, $name', "Hello, $name", $'Hello, $name', "one\ntwo", $'Hello, $$name')
end

test "Typed expression quotes"
  x = 2
  raw = Code` x ^ 2
  expanded = Code$` $x ^ 2

  expect raw is
    (x ^ 2) :: Code
  end
  expect expanded is
    (2 ^ 2) :: Code
  end
  (raw, expanded)
end

test "Typed parse / toString round-trip"
  def Rectangle type :Rect(width :: Float, height :: Float)
  value = Rect(3, 4) :: Rectangle
  text = toString(Rectangle)(value)

  expect text is "Rect(3, 4)" :: String

  assert parse(Rectangle)(text) == value

  (text, (parse(Rectangle)(text) == value))
end
