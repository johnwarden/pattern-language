test "Capture accessors"
  def Rectangle type :Rect(w :: Float, h :: Float)
  r = Rect(3, 4) :: Rectangle

  expect r.w is 3 :: Float
  expect w(r) is 3 :: Float
  (r.w, w(r))
end

test "Defaults in function arguments"
  def Plain type Rect(Int, Int)
  def Rectangle type :Rect(width :: Int, height :: Int, color: String)
  def colorOf(Rect(w, h, color: String = "black")) color
  raw = Rect(3, 4) :: Plain

  expect colorOf(raw) is "black" :: String
  expect raw is Rect(3, 4) :: Plain
  (colorOf(raw), raw)
end

test "Exact fields and rest markers"
  def Packet type Rect(Int, Int, Int, color: Symbol, note: String)
  Rect(w, h, ..., color: c, **) = Rect(2, 3, 4, color: :Black, note: "extra") :: Packet

  expect w is 2 :: Int
  expect h is 3 :: Int
  expect c is Black :: UpperCamelSymbol
  (w, h, c)
end

test "Labels containing patterns"
  def Rectangle type Rectangle(Int, Int)
  def area(shape: Rectangle(w, h)) w * h

  expect area(shape: (Rectangle(3, 4) :: Rectangle)) is 12 :: Int
end

test "Named result capture"
  (x, foo: String) = (1, foo: "bar")

  expect x is 1 :: NumericValue
  expect foo is "bar" :: String
  (x, foo)
end

test "Patterns as values"
  p = type :Pair(Int, Int)
  testPair = matches(Pair(1, 2))

  assert testPair(p)

  assert not(Pair(1, "x") .matches p)
  (testPair(p), Pair(1, "x") .matches p)
end

test "Picture: nested pattern captures"
  def Picture type :Picture(color: (type :Red | :Black), shape: Rectangle(w :: Float, h :: Float))
  p = Picture(color: :Red, shape: Rectangle(3, 4)) :: Picture

  expect p.color is Red :: (type :Red | :Black)
  expect p.w is 3 :: Float
  expect p.h is 4 :: Float
  observed = type Picture
  expect observed is Struct(Picture(color: Struct(:Black | :Red), shape: Rectangle(Float, Float))) :: Type
  (p.color, p.w, p.h, (type Picture))
end
