test "Canonical type alternatives"
  a = type :Red | :Black
  b = type :Black | :Red

  assert a == b
  # Legacy blocked: public descriptor text is still provisional; retain normalization and round-trip checks.
  legacy expect toString(Type)(a) is "Type(:Black | :Red)" :: String

  assert parse(Type)(toString(Type)(a)) == b

  ((a == b), toString(Type)(a), (parse(Type)(toString(Type)(a)) == b))
end

test "Typed Code and recursive splicing"
  def wrap(n, e :: Code)
    if n == 0 e else
      inner = wrap(n - 1, e)
      Code$` inc($inner)
    end
  end
  c = wrap(3, Code` 1)

  expect c is inc(inc(inc(1))) :: Code
end

test "Factory defaults and complete types"
  def Color type :Black | :White
  def Rectangle type :Rect(w :: Int, h :: Int, color: Color)
  def rectangle(w :: Int, h :: Int, color: Color = :Black) Rect(w, h, color: color) :: Rectangle
  r = rectangle(3, 4)

  expect r is Rect(3, 4, color: Black) :: Rectangle
  expect r.color is Black :: Color
  # Legacy blocked: public descriptor text is still provisional.
  legacy expect toString(Type)(type Rectangle) is "Type(Rect(Int, Int, color: Type(:Black | :White)))" :: String

  assert not(:(Rect(3, 4)) .matches (type Rectangle))
  (r, r.color, toString(Type)(type Rectangle), :(Rect(3, 4)) .matches (type Rectangle))
end

test "Optional labeled defaults"
  def Color type :Black | :White
  (size: s :: Int, color: c :: Color = :Black) = (size: 3)

  expect c is Black :: Color
end

test "Type fields and ignored captures"
  def Rectangle type :Rect(width :: Float, height :: Float)
  r = Rect(3, 4) :: Rectangle
  Rect(_, h) = r

  observed = type Rectangle
  expect observed is Type(Rect(Float, Float)) :: Type
  expect h is 4 :: Float
  ((type Rectangle), h)
end

test "Inspect a pattern union"
  t = type :Some(Int) | :None
  Type(:|(left)(right)) = t

  legacy expect left is :None :: Expression
  legacy expect right is Some(Int) :: Expression
  (left, right)
end

test "Local and global type text"
  def Rectangle type :Rect(width :: Float, height :: Float)
  t = type Rectangle
  local = toStringLocal(Type)(t)
  global = toString(Type)(t)

  expect local is "Rectangle" :: String
  # Legacy blocked: local alias policy and global descriptor spelling are still provisional.
  legacy expect global is "Type(Rect(Float, Float))" :: String

  assert parseLocal(Type)(local) == t

  assert parse(Type)(global) == t

  (local, global, (parseLocal(Type)(local) == t), (parse(Type)(global) == t))
end

test "Mutually recursive mathematical expression types"
  def Sum type
    (a :: MathExp) :+ (b :: MathExp)
  end
  def Product type
    (a :: MathExp) :* (b :: MathExp)
  end
  def MathExp UnionType(Sum, Product, Symbol, Float)
  sum = parse(Sum)("1 :+ 2")
  expression = parse(Product)("(1 :+ 2) :* 3")
  text = toString(Product)(expression)

  assert parse(Product)(text) == expression

  assert parse(Type)(toString(Type)(MathExp)) == MathExp

  ((parse(Product)(text) == expression), (parse(Type)(toString(Type)(MathExp)) == MathExp))
end

test "Named types and local accessors"
  def Left type :Left(x :: Int)
  def Right type :Right(x :: Int)
  def Outer type :Outer(Left, Right)
  r = Outer(Left(2), Right(3)) :: Outer
  Outer(left, right) = r

  expect left.x is 2 :: Int
  expect x(right) is 3 :: Int
  (left.x, x(right))
end

test "A union of type values"
  def Circle type :Circle(Float)
  def Square type :Square(Float)
  shape = UnionType(type Circle, type Square)

  expect shape is UnionType(Type(Circle(Float)), Type(Square(Float))) :: Type
end

test "Option factory with ()"
  def Option(T :: Type) type :None | Some(T)
  a = :None :: Option(Int)
  b = Some(5) :: Option(Int)

  expect toString(Option(Int))(a) is "None" :: String
  expect a is None :: Option(Int)
  expect b is Some(5) :: Option(Int)
  expect Option(Int) is Type(:None | Some(Int)) :: Type
  (toString(Option(Int))(a), b, Option(Int))
end

test "All symbols print bare in value text"
  def Choice type :yes | :None | :Widget
  x = :yes :: Choice
  y = :None :: Choice
  z = :Widget :: Choice

  expect toString(Choice)(x) is "yes" :: String
  expect toString(Choice)(y) is "None" :: String
  expect toString(Choice)(z) is "Widget" :: String
  expect x is yes :: Choice
  expect y is None :: Choice
  expect z is Widget :: Choice
  assert parse(Choice)(toString(Choice)(x)) == x
  assert parse(Choice)(toStringLocal(Choice)(x)) == x
end

test "Type arguments use ordinary packs"
  def nonZero(T :: Type)(n :: T) n != (0 :: T)

  assert nonZero(Int)(5)

  assert not(nonZero(Int)(0))
  assert nonZero(Float)(0.5)
  (nonZero(Int)(5), nonZero(Int)(0), nonZero(Float)(0.5))
end

test "Types use ordinary value equality"
  cached = type Int
  tree = Int
  value = 3 :: tree

  assert cached == tree

  assert toString(Type)(cached) == toString(Type)(tree)

  assert parse(tree)(toString(tree)(value)) == value

  ((cached == tree), (toString(Type)(cached) == toString(Type)(tree)), (parse(tree)(toString(tree)(value)) == value))
end

test "Picture: named shape type"
  def Rectangle type :Rectangle(w :: Float, h :: Float)
  def Picture type :Picture(color: (type :Red | :Black), shape: Rectangle)
  p = Picture(color: :Black, shape: Rectangle(3, 4)) :: Picture

  expect p.shape is Rectangle(3, 4) :: Rectangle
  expect p.shape.w is 3 :: Float
  expect p.shape.h is 4 :: Float
  (p.shape, p.shape.w, p.shape.h)
end

test "Recursive type"
  def List(t :: Type) type :Nil | :Cons(t, List(t))

  expect Cons(1, Cons(2, :Nil)) :: List(Int) is Cons(1, Cons(2, Nil)) :: List(Int)
end

test "Local recursive type block"
  (x :: (
    def List(t :: Type) type :Nil | :Cons(t, List(t))
    List(Int)
  )) = Cons(5, :Nil)

  expect x is Cons(5, Nil) :: (parse(Type)("Type(Recursive(:Nil | Cons(Int,Recur(0))))"))
end

test "Portable recursive type"
  def List(t :: Type) type :Nil | :Cons(t, List(t))
  t = type List(Int)
  text = toString(Type)(t)
  restored = parse(Type)(text)
  value = Cons(5, :Nil) :: restored
  # Legacy blocked: public recursive descriptor text is still provisional.
  legacy expect text is "Type(Recursive(:Nil | Cons(Int, Recur(0))))" :: String

  assert restored == t

  assert parse(restored)(toString(restored)(value)) == value

  (text, (restored == t), (parse(restored)(toString(restored)(value)) == value))
end

test "Ordinary factory with defaults"
  def Rectangle type :Rect(width :: Int, height :: Int, color: String)
  def rectangle(w :: Int, h :: Int, color: String = "black") Rect(w, h, color: color) :: Rectangle
  r = rectangle(3, 4)

  expect r is Rect(3, 4, color: "black") :: Rectangle
  expect r.color is "black" :: String
  expect Rectangle(3, 4) is Rectangle(3, 4) :: Expression
  (r, r.color, Rectangle(3, 4))
end

test "Subset of an optional type"
  def NoInt Int? .where v -> v .matches :None
  a = :None :: NoInt
  b = :None :: Int?

  assert a == b
end

test "Tuple type"
  def Tuple(ts... :: Type*) type {ts…}

  expect {1, "hello"} :: Tuple(Int, String) is {1, "hello"} :: Tuple(Int, String)
end

test "Types are ordinary values"
  def Rect type Rect(Float, Float)
  r = Rect

  expect r is Type(Rect(Float, Float)) :: Type
  expect Int is Int :: ReservedSymbol
  expect Float is Float :: ReservedSymbol
  expect Type(Int) is Type(Int) :: Type
  (r, Int, Float, Type(Int))
end

test "Type factory · ordinary calls"
  def restrict(base)(predicate) base .where predicate
  small = restrict(type Int)(n -> n < (5 :: Int))

  expect 3 :: small is 3 :: Int
end

test "Type normalization and wrappers"
  def Rect type Rect(Float, Float)

  observedInt = type Int
  observedTypeInt = type type Int
  observedTypeRect = type type Rect
  expect observedInt is Int :: Type
  expect observedTypeInt is Int :: Type
  expect Type(Int) is Type(Int) :: Type
  expect observedTypeRect is Type(Rect(Float, Float)) :: Type
  ((type Int), (type type Int), Type(Int), (type type Rect))
end

test "Types as ordinary values"
  def Rectangle type :Rect(width :: Float, height :: Float)
  t = Type(Rect(Float, Float))
  Type(pattern) = t

  assert Type(pattern) == t

  assert t == (type Rectangle)
  # Legacy blocked: public descriptor text is still provisional.
  legacy expect toString(Type)(t) is "Type(Rect(Float, Float))" :: String

  ((Type(pattern) == t), (t == (type Rectangle)), toString(Type)(t))
end

test "Inspect a typed code binding without evaluating it"
  def isBinding(e)
    match syntaxTree(e)
      Apply(Apply(Name("=", False), _), _) -> True
      _ -> False
    end
  end
  def Binding Code .where e -> isBinding(e)

  code = Code` f = x -> x * 2
  (patternText, bodyText) =
    match code
      (binding :: Binding) ->
        Apply(Apply(_, left), right) = syntaxTree(binding)
        [Field("_1", pattern)] = left
        [Field("_1", value)] = right
        (toString(Code)(Code(syntaxExpression(pattern))), toString(Code)(Code(syntaxExpression(value))))
      end
      _ -> panic("Expected a binding")
    end
  end

  expect patternText is "f" :: String
  expect bodyText is "x -> x * 2" :: String
  (patternText, bodyText)
end

test "Overlapping unions and narrowing"
  def IntOrString UnionType(type Int, type String)
  def IntOrBool UnionType(type Int, type Bool)
  (x :: IntOrString) = (3 :: Int)
  (y :: IntOrBool) = (3 :: Int)

  assert
    match x
      (a :: Int) -> match y
        (b :: Int) -> a == b
        _ -> False
      end
      _ -> False
    end
  end
end

test "Numeric spaces and conversion"
  (x :: Float .where (n -> isInt64(n))) = 10
  (y :: Int) = 10

  assert x.toInt == y
end
