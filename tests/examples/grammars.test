test "DSL: Infix syntax and distinct argument packs"
  def Atom unionType Number | String | Symbol
  def Application type (head :: ValueExpr)(args... :: ValueExpr*)
  def ValueExpr unionType Atom | Application

  infix = ValueExpr` a + b
  prefix = ValueExpr` +(a)(b)
  packed = ValueExpr` f(a, b)
  successive = ValueExpr` f(a)(b)

  text = toString(ValueExpr)(infix)
  # Surface sugar preserves the application tree, including pack boundaries.
  assert (infix == prefix)

  assert False == (packed == successive)
  legacy expect text result "a + b" :: Expression
  todo expect text result "a + b" :: String

  assert (parse(ValueExpr)(text) == infix)

  ((infix == prefix), (packed == successive), text, (parse(ValueExpr)(text) == infix))
end

test "Sidefix data DSL"
  def ExpectedOutput type (e :: Expression) ::: (type :: Expression)
  # Expression is a temporary bridge for the future typed Code field.
  def Expectation type (:expect (subject :: Expression) :result (expected :: ExpectedOutput))
  def Test type (:test (name :: String) (check :: Expectation))
  t = Test`
    test "Stored test data"
      expect missing(1 / 0) result 3 :: MissingType
  end

  expect t.name result "Stored test data" :: String
  legacy expect t.check.expected.e result 3 :: Expression
  legacy expect t.check.expected.type result :MissingType :: Expression
  (t.name, t.check.expected.e, t.check.expected.type)
end

test "DSL: Recursive expression grammar"
  # One numeric space until numeric literals distinguish Int from Float.
  def Atom unionType Number | String | Symbol
  def Application type (head :: ValueExpr)(args... :: ValueExpr*)
  def ValueExpr unionType Atom | Application

  expression = ValueExpr` a + b
  # a + b is +(a)(b). The outer head is the application +(a).
  (head :: ValueExpr)(args... :: ValueExpr*) = expression
  (operator :: ValueExpr)(left... :: ValueExpr*) = head

  expect expression result (a + b) :: Application
  legacy expect toString(ValueExpr)(head) result "+(a)" :: Expression
  todo expect toString(ValueExpr)(head) result "+(a)" :: String
  legacy expect toString(ValueExpr*)(args) result "[b]" :: Expression
  todo expect toString(ValueExpr*)(args) result "[b]" :: String
  legacy expect toString(ValueExpr)(operator) result "+" :: Expression
  todo expect toString(ValueExpr)(operator) result "+" :: String
  legacy expect toString(ValueExpr*)(left) result "[a]" :: Expression
  todo expect toString(ValueExpr*)(left) result "[a]" :: String
  (expression, toString(ValueExpr)(head), toString(ValueExpr*)(args), toString(ValueExpr)(operator), toString(ValueExpr*)(left))
end

test "DSL: Tests with explicit value and type"
  def ExpectedOutput type (e :: Expression) ::: (type :: Expression)
  def Test type (:test (name :: String) (code :: Code) :expect (actual :: Expression) :result (expected :: ExpectedOutput))

  # This is an ordinary data grammar. Both expectation operands stay inert.
  t = Test`
    test "An unevaluated calculation"
      1 / 0
    expect :result result (a + b) :: MissingType
  end

  # Inspect the parts; the quoted calculation is never evaluated here.
  expect t.name result "An unevaluated calculation" :: String
  legacy expect toString(Code)(t.code) result "(\n  (1 / 0)\n)" :: Expression
  todo expect toString(Code)(t.code) result "(\n  (1 / 0)\n)" :: String
  legacy expect t.actual result :result :: Expression
  legacy expect t.expected.e result (:a + :b) :: Expression
  legacy expect t.expected.type result :MissingType :: Expression
  (t.name, toString(Code)(t.code), t.actual, t.expected.e, t.expected.type)
end

test "Test DSL with typed Code"
  def ExpectedOutput type (e :: Expression) ::: (type :: Expression)
  def Expectation type (:expect (code :: Code) :result (expected :: ExpectedOutput))
  def Test type (:test (name :: String) (check :: Expectation))
  t = Test`
    test "Typed code body"
      expect
        x = 3
        x + 1
      result 4 :: Int
  end

  expect t.name result "Typed code body" :: String
  legacy expect t.check.expected.e result 4 :: Expression
  legacy expect t.check.expected.type result Int :: Expression
  (t.name, t.check.expected.e, t.check.expected.type)
end

test "DSL: Symbols and unannotated unions"
  def MathExp unionType Symbol | Number
  (a :: MathExp) = :a
  text = toString(MathExp)(a)

  expect a result a :: LowerCamelSymbol
  legacy expect text result "a" :: Expression
  todo expect text result "a" :: String

  assert (parse(MathExp)(text) == a)

  (a, text, (parse(MathExp)(text) == a))
end

test "Vertical spreading: Inspect a nested Body"
  # A bounded source grammar for inert code inspection. No evaluation is installed.
  def Capture type (name :: LowerCamelSymbol) ::: (annotation :: Expression)
  def Pattern unionType LowerCamelSymbol | Capture
  def Sum type (left :: ValueExpression) :+ (right :: ValueExpression)
  def Product type (left :: ValueExpression) :* (right :: ValueExpression)
  def ValueExpression unionType Number | String | Symbol | Sum | Product
  def FunctionSignature type (name :: LowerCamelSymbol)(parameters... :: Pattern*)
  def Definition type (:def (signature :: FunctionSignature) (value :: (unionType ValueExpression | Body)))
  def DestructuringBinding type (patterns... :: Pattern*) := (value :: (unionType ValueExpression | Body))
  def Binding unionType DestructuringBinding | Definition
  def Body type
    bindings :: Binding*
    ...
    resultExpression... :: ValueExpression*
  end

  binding = DestructuringBinding`
    (a, b) =
      y = 2
      z = 3
      (y * z, y)
    end
  end
  ((first :: LowerCamelSymbol, second :: LowerCamelSymbol) := (body :: Body)) = binding

  expect first result a :: LowerCamelSymbol
  expect second result b :: LowerCamelSymbol

  legacy expect toString(Binding*)(body.bindings) result "[y = 2, z = 3]" :: Expression

  todo expect toString(Binding*)(body.bindings) result "[y = 2, z = 3]" :: String
  legacy expect toString(ValueExpression*)(body.resultExpression) result "[y * z, y]" :: Expression
  todo expect toString(ValueExpression*)(body.resultExpression) result "[y * z, y]" :: String

  assert (parse(Body)(toString(Body)(body)) == body)

  (first, second, toString(Binding*)(body.bindings), toString(ValueExpression*)(body.resultExpression), (parse(Body)(toString(Body)(body)) == body))
end

test "Vertical spreading: Two-dimensional lists"
  def Matrix type [
    values... :: Float**
    ...
  ]
  (m :: Matrix) = [
    1, 2
    3, 4
  ]

  expect m.values result [[1, 2], [3, 4]] :: *(*(Float))

  assert (parse(Matrix)(toString(Matrix)(m)) == m)

  (m.values, (parse(Matrix)(toString(Matrix)(m)) == m))
end

test "Vertical spreading: TodoList"
  def TodoList type :todo
    todos :: String*
    ...
  end
  list = TodoList`
    todo
      "item 1"
      "item 2"
    end
  end

  expect list.todos result ["item 1", "item 2"] :: *(String)

  assert (parse(TodoList)(toString(TodoList)(list)) == list)

  (list.todos, (parse(TodoList)(toString(TodoList)(list)) == list))
end

test "Unquoted expected-grammar DSL"
  def MyDsl type (:do String :with String)
  def show(x :: MyDsl) x
  x = MyDsl` do "Foo" with "bar"
  name = "bar"
  (y :: MyDsl) = do "Foo" with name

  assert (x == y)
  assert (show(do "Foo" with name) == x)

  (x == y)
end
