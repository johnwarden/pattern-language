test "Macro-generated local grammar"
  macro :install :answer Code` macro :answer x :: Expression Code$` $(x)
  def demo()
    install answer
    answer 42
  end

  expect demo() result 42 :: Rational
end

test "Sidefix macro: choose"
  macro :choose c :: Expression a :: Expression b :: Expression Code$` if $(c) $(a) else $(b)

  expect
    choose True 42 1 / 0
  result 42 :: Rational
end

test "Code function versus registered macro"
  def twiceCode(e) Code$` $(e) + $(e)
  macro :twice e :: Expression
    twiceCode(e)
  end

  expect twiceCode(2 + 3) result
    (5 + 5) :: Code
  end
  expect
    twice 2 + 3
  result 10 :: Rational
  (twiceCode(2 + 3), (twice 2 + 3))
end

test "Sidefix macro: unless"
  macro :unless c :: Expression v :: Body
    Code$` if $(c) 0 else $(v)
  end

  expect
    unless False
      x = 3 :: Int
      x + (1 :: Int)
    end
  result 4 :: Int
end

test "Typed Code: recursive for each macro"
  def each(xs)(f)
    match xs
      [] -> []
      [first, rest...] -> [f(first), rest.each(f)...]
    end
  end

  def Binding type
    (n :: Expression) .:in e :: Expression
  end
  def expandFor(bindings :: Binding*, body :: Expression)
    match bindings
      [] -> Code$` $body
      [first, rest...] ->
        (name .:in source) = first
        inner = expandFor(rest, body)
        Code$` $(source).each($name -> $inner)
      end
    end
  end
  macro :for :each(bindings... :: Binding*) e :: Expression
    expandFor(bindings, e)
  end

  code = expandFor([:x .:in [1, 2, 3], :y .:in [4, 5, 6]], :(x * y))
  value = for each(x .in [1, 2, 3], y .in [4, 5, 6]) x * y

  expect code result
    (each([1, 2, 3])(x -> each([4, 5, 6])(y -> x * y))) :: Code
  end
  legacy expect value result [[4, 5, 6], [8, 10, 12], [12, 15, 18]] :: Expression
  (code, value)
end
