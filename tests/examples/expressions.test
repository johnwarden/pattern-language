test "Abstract slots preserve identity"
  n = 3 :: Int
  (x :: Any) = n
  assert n == x

  (y :: Int) = x
  assert x == y

  expect toString(Any)(x) is "3 :: Int64" :: String
  expect toString(Int)(x) is "3" :: String

  ((n == x), (x == y), toString(Any)(x), toString(Int)(x))
end

test "Accessor ambiguity"
  expect
    def Rectangle type :Rect(w :: Float, h :: Float)
    def w(x) 99
    r = Rect(3, 4) :: Rectangle
    r.w
  fails "E_AMBIGUOUS_CALL"
end

test "Result arity error"
  expect
    x =
      y = 1
      (y, y)
    end
    x
  fails "E_PATTERN_MISMATCH"
end

test "Function block"
  def f(x :: Int)
    y = x ^ (2 :: Int)
    y + (1 :: Int)
  end

  expect f(3) is 10 :: Int
end

test "Definitions evaluate their bodies"
  def r :(Rect(Float64))
  def R type :Rect(Float64)

  expect :(Rect(Float64)) is Rect(Float64) :: Expression
  observed = type R
  expect observed is Struct(Rect(Float64)) :: Type
  (r, (type R))
end

test "Zero results"
  def nothing()
    ()
  end

  assert
    () =
      nothing()
    end
    True
  end
end

test "Deferred expected output"
  def ExpectedOutput type
    (e :: Expression) ::: (type :: Expression)
  end
  expected = ExpectedOutput` (1 / 0) :: MissingType
  legacy expect expected.e is
    (1 / 0) :: Expression
  end
  legacy expect expected.type is :MissingType :: Expression
  todo expect expected.type is MissingType :: UpperCamelSymbol
  (expected.e, expected.type)
end

test "Ignore named results"
  x = (1, foo: "bar")

  expect x is 1 :: NumericValue
end

test "Narrow an abstract slot"
  (x :: Any) = (3 :: Int)
  (value :: Int) = x

  expect value is 3 :: Int
  observed = type Int
  expect observed is Int64 :: Type

  assert value == x

  (value, (type Int), (value == x))
end

test "Language as data"
  l = language()
  assert l .matches languageSchema()

  s = toString(Expression)(l)
  r = parse(Expression)(s)
  assert r == l

  Language(rules: rules, **) = l
  legacy expect rules.len is 14 :: Expression

  Block(nodes) = parseSyntax(r)("if True 1 else 2")
  legacy expect nodes.len is 1 :: Expression

  (l .matches languageSchema(), (r == l), rules.len, nodes.len)
end

test "Match"
  def Option type :None | Some(Int)

  expect
    match Some(3) :: Option
      :Some(v) -> v.toString
      :None -> ""
    end
  is "3" :: String
end

test "Explicit primitive values"
  t = Float

  expect t is Float64 :: Type
  expect Int is Int64 :: Type
  expect Bool is Bool :: ReservedSymbol

  assert t == (type Float)
  assert Int === Int64
  assert Float === Float64

  (t, Int, Bool, (t == (type Float)))
end

test "Raw block preserves blank lines and dollars"
  expect
    '
      Quotes: " ' `
      Dollars: $name $(anything)
      Backslashes: \n

    end
  is "Quotes: \" ' `\nDollars: $name $(anything)\nBackslashes: \\n\n" :: String
end

test "Mutually recursive function definitions"
  def even(n) if n == 0 True else odd(n - 1)
  def odd(n) if n == 0 False else even(n - 1)

  assert even(8)
  assert odd(7)

  assert not(even(7))
  (even(8), odd(7), even(7))
end

test "Multiple results"
  def pair(x)
    (x, x)
  end
  (a, b) = pair(3 :: Int)

  expect a + b is 6 :: Int
end

test "Extra named arguments"
  def f(x) x

  expect f(1, foo: "bar") is 1 :: NumericValue
end

test "Open structural facet"
  def Colored type :Rect(Float, Float, color: String)
  def Rectangular type :Rect(w :: Float, h :: Float, **)
  r = Rect(2, 3, color: "black") :: Colored
  (p :: Rectangular) = r

  expect p is Rect(2, 3, color: "black") :: Colored
  expect p.w is 2 :: Float
  expect p.h is 3 :: Float

  assert p == r
  # Legacy blocked: abstract facet reconstruction text is still provisional (C15).
  legacy expect toString(Rectangular)(p) is "Rect(2, 3, color: \"black\") :: Struct(Rect(Float64, Float64, color: String))" :: String

  assert parse(Rectangular)(toString(Rectangular)(p)) == r

  (p, p.w, p.h, (p == r), toString(Rectangular)(p), (parse(Rectangular)(toString(Rectangular)(p)) == r))
end

test "Inspect and rebuild syntax"
  original = :(factory(1)(2, color: :Red))
  :factory(first)(second, color: tint) = original
  rebuilt = Code$` factory($(first))(3, color: $(tint))

  expect first is 1 :: Expression
  expect second is 2 :: Expression
  expect tint is :Red :: Expression
  expect toString(Code)(rebuilt) is "factory(1)(3, color: :Red)" :: String
  expect rebuilt is factory(1)(3, color: :Red) :: Code
  assert rebuilt != Code(original)
  (first, second, tint, rebuilt)
end

test "Abstract slots and ordering"
  def U UnionType(type Int, type String)
  (a :: U) = (99 :: Int)
  (b :: U) = ("0" :: String)

  expect a is 99 :: Int
  expect b is "0" :: String
  assert a < b
  expect toString(U)(a) is "99" :: String

  assert parse(U)(toString(U)(a)) == a

  (a, b, (a < b), toString(U)(a), (parse(U)(toString(U)(a)) == a))
end

test "User-defined if"
  macro :if c :: Expression v :: Body :else a :: Body
    Code$`
      match $(c)
        True -> $(v)
        False -> $(a)
      end
    end
  end

  expect
    if True 42 else 1 / 0
  is 42 :: NumericValue
end

test "Vector"
  def Vector(t :: Type) type [values... :: t*]
  (v :: Vector(Float)) = [1, 2]

  expect v is [1, 2] :: Vector(Float)
end
