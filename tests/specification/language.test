test "C23 supported global typed text preserves value identity"
  assert
    type Rectangle concrete Rect(w :: Float32, h :: Float32)
    r = (Rect(2, 3) :: Rectangle)
    text = toString(Rectangle)(r)
    restored = parse(Rectangle)(text)
    (restored == r)
  end

  todo assert
    type Rectangle concrete Rect(w :: Float32, h :: Float32)
    r = (Rect(2, 3) :: Rectangle)
    text = toString(Rectangle)(r)
    restored = parse(Rectangle)(text)
    assert restored == r
    (toString(Rectangle)(restored) == text)
  end
end

test "C24 applications preserve complete successive packs"
  def combine(x, y)(z)
    (x, y, z)
  end
  partial = combine(1, 2)
  (a, b, c) = partial(3)
  expect a is 1 :: NumericValue
  expect b is 2 :: NumericValue
  expect c is 3 :: NumericValue
  def empty()
    ()
  end
  () = empty()

  todo expect
    x = (1, 2)
    (one) = x
    one
  fails "one capture cannot consume two positional results"
end

test "C25 infix operators retain equal precedence"
  expect (2 :: Float64) * ((3 :: Float64) + (4 :: Float64)) is 14 :: Float64
  def select(a)(b) b
  expect 1 .select 2 is 2 :: NumericValue
end

test "C26 todo assertions execute in isolated scopes"
  marker = 1

  todo assert FuturePredicate(FutureValue)
  todo expect FutureSubject() is FutureExpected() :: FutureType
  todo expect
    marker = 2
    def futureLocal() 99
    missing()
  is 0 :: Expression

  expect
    futureLocal()
  fails "E_UNBOUND_NAME"

  expect marker is 1 :: NumericValue
end

test "C27 candidate Code rejection of redundant primitive quotation"
  todo expect
    :5
  fails "primitive quotation is not a Code form"

  todo expect
    :Bool
  fails "primitive quotation is not a Code form"
end
