test "Tight suffixes wrap one character at a time"
  assert parse(Code)("Int**") == parse(Code)("(Int*)*")
  assert parse(Code)("String?*^!") == parse(Code)("(((String?)*)^)!")
end

test "Prefix plus forms are the same tree; tight Int+ is not"
  assert parse(Code)("+Int") == parse(Code)("+(Int)")
  expect parse(Code)("Int+") fails "infix operators require spaces"
  expect parse(Code)("Int*+") fails "infix operators require spaces"
  expect parse(Code)("a+") fails "infix operators require spaces"
end

test "Spaced plus and star remain infix"
  expect parse(Code)("a+b") fails "infix operators require spaces"
  assert parse(Code)("a + b") == parse(Code)("+(a)(b)")
  assert parse(Code)("T * U") == parse(Code)("*(T)(U)")
  expect 2 * 3 is 6 :: Rational
  expect 2 + 3 is 5 :: Rational
end

test "A pack field ** is not a suffix wrap on the previous field"
  assert parse(Code)("Rect(w, h, **)") != parse(Code)("Rect(w, h**)")
end

test "Tight bang is a postfix construction"
  expect 1! is 1! :: Expression
end

test "The bootstrap list convention retains list matching"
  expect [1, 2] :: Int* is [1, 2] :: Int*
end
