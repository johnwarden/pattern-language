test "A direct union arm takes precedence over inward designation"
  (outer :: Float??) = :None
  (sameOuter :: Float??) = :None :: Float??
  (inner :: Float??) = :None :: Float?

  expect outer is None :: Float??
  expect inner is (None :: Float?) :: Float??
  expect toString(Float??)(outer) is "None" :: String
  # Legacy: the exact old Type(...) suffix. The todos are the descriptor's ordinary value text; symbols stay quoted inside a descriptor.
  legacy expect toString(Float??)(inner) is "None :: Type(Float | :None)" :: String
  todo expect toString(Float??)(inner) is "None :: ConcreteType(Float | :None)" :: String
  assert outer == sameOuter
  assert outer != inner
  assert parse(Float??)(toString(Float??)(outer)) == outer
  assert parse(Float??)(toString(Float??)(inner)) == inner
end

test "Nested String options print relative to the requested grammar"
  (inner :: String??) = :None :: String?

  # Legacy: the exact old Type(...) suffix (see above).
  legacy expect toString(String??)(inner) is "None :: Type(:None | String)" :: String
  todo expect toString(String??)(inner) is "None :: ConcreteType(:None | String)" :: String
  assert parse(String??)(toString(String??)(inner)) == inner
  assert parse(Any)(toString(Any)(inner)) == inner
end

test "An explicit concrete member identifies an otherwise ambiguous branch"
  def MyType type String? | Float?
  (x :: MyType) = :None :: String?
  (y :: MyType) = :None :: Float?

  expect x is (None :: String?) :: MyType
  expect y is (None :: Float?) :: MyType
  # Legacy: the exact old Type(...) suffix (see above).
  legacy expect toString(MyType)(x) is "None :: Type(:None | String)" :: String
  todo expect toString(MyType)(x) is "None :: ConcreteType(:None | String)" :: String
  legacy expect toString(MyType)(y) is "None :: Type(Float | :None)" :: String
  todo expect toString(MyType)(y) is "None :: ConcreteType(Float | :None)" :: String
  assert x != y
  assert parse(MyType)(toString(MyType)(x)) == x
  assert parse(MyType)(toString(MyType)(y)) == y
  expect
    (ambiguous :: MyType) = :None
    ambiguous
  fails "E_AMBIGUOUS_PATTERN"
end
