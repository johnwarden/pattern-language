test "Prefix minus negates; infix minus subtracts"
  x = 3
  n = -1
  grouped = -(1)
  nx = -x
  groupedX = -(x)
  assert n == negate(1)
  assert grouped == n
  assert nx == negate(x)
  assert groupedX == nx
  assert (1 - x) == negate(2)
  expect 1 - -x is 4 :: Rational
  expect 1 - -2 is 3 :: Rational
  expect 5 - (2) is 3 :: Rational
  assert parse(Code)("-1") != parse(Code)("-(1)")
  assert parse(Code)("-x") == parse(Code)("-(x)")
  quotedPrefix = Code` -1
  quotedGrouped = Code` -(x)
  quotedInfix = Code` 1 - x
  quotedNested = Code` 1 - -x
  assert quotedPrefix == parse(Code)("-1")
  assert quotedGrouped == parse(Code)("-(x)")
  assert quotedInfix == parse(Code)("1 - x")
  assert quotedNested == parse(Code)("1 - -x")
  assert parse(Code)(toString(Code)(quotedPrefix)) == quotedPrefix
  assert parse(Code)(toString(Code)(quotedGrouped)) == quotedGrouped
  assert parse(Code)(toString(Code)(quotedInfix)) == quotedInfix
  assert parse(Code)(toString(Code)(quotedNested)) == quotedNested
end

test "Prefix minus preserves concrete numeric types and finite float ranges"
  integer = -(1 :: Int)
  singlePrecision = -(1 :: Float32)
  doublePrecision = -(1 :: Float64)

  expect integer is
    -1 :: Int
  end
  expect singlePrecision is
    -1 :: Float32
  end
  expect doublePrecision is
    -1 :: Float64
  end

  large64 = 0x1p1023 :: Float64
  negative64 = -large64
  assert negative64 < (0 :: Float64)
  assert (-negative64) == large64
  assert parse(Float64)(toString(Float64)(negative64)) == negative64

  large32 = 0x1p100 :: Float32
  negative32 = -large32
  assert negative32 < (0 :: Float32)
  assert (-negative32) == large32

  subnormal = 0x1p-1074 :: Float64
  negativeSubnormal = -subnormal
  assert negativeSubnormal < (0 :: Float64)
  assert (-negativeSubnormal) == subnormal
end
