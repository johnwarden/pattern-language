test "C04 raw expressions are allowed and explicit types establish an interpretation"
  expect
    type Rectangle concrete Rect(w :: Float32, h :: Float32)
    r = (Rect(2, 2) :: Rectangle)
    r
  is
    (
      Rect(2, 2)
    ) :: (
      type Rectangle concrete Rect(w :: Float32, h :: Float32)
      r = (Rect(2, 2) :: Rectangle)
      Rectangle
    )
  end

  legacy expect
    x = Rect(2, 2)
    x
  is Rect(2, 2) :: Expression

  todo expect
    x = Rect(2, 2)
    x
  fails "E_UNTYPED_CONSTRUCTOR"
end

test "UpperCamel heads construct; lowerCamel heads call"
  def box(n) n
  expect box(3) is 3 :: NumericValue
  expect Box(3) :: Expression is Box(3) :: Expression
  type IntBox concrete Box(NumericValue)
  expect Box(3) :: IntBox is Box(3) :: IntBox
end

test "A TitleCase definition is a type factory, not an ordinary function call"
  def Box(x) x
  expect Box(3) fails "E_EXPECTED_TYPE"
end

test "C05 types are structural values"
  assert
    type Rectangle concrete Rect(w :: NumericValue, h :: NumericValue)
    t = Rectangle
    u = concrete Rect(NumericValue, NumericValue)
    (t == u)
  end

  assert
    type Rectangle struct Rect(w :: String, h :: String)
    plain = struct Rect(String, String)
    (Rectangle === plain)
  end

  expect
    type Rectangle struct Rect(w :: String, h :: String)
    plain = struct Rect(String, String)
    toString(Type)(plain)
  is "Struct(Rect(String, String))" :: String

  todo assert
    type Box<T> concrete Box(T)
    (Box<String> == (concrete Box(String)))
  end

  todo expect
    type Box<T> concrete Box(T)
    b = (Box("hello") :: Box<String>)
    match b
      Box(text) -> text
    end
  is
    "hello" :: String
  end
end

test "C06 equal spellings can belong to different concrete spaces"
  expect
    type PrimaryColor concrete :Red | :Green | :Blue
    type TicketStatus concrete :Red | :Green
    red = (:Red :: PrimaryColor)
    stopped = (:Red :: TicketStatus)
    (red == stopped)
  fails "E_INCOMPARABLE_TYPES"

  expect
    type PrimaryColor struct :Red | :Green | :Blue
    type TicketStatus struct :Red | :Green
    red = (:Red :: PrimaryColor)
    stopped = (:Red :: TicketStatus)
    (red === stopped)
  fails "E_INCOMPARABLE_TYPES"
end
