test "C04 raw expressions are allowed and explicit types establish an interpretation"
  x = Rect(2, 2)
  Rect(w, h) = x

  expect x is Rect(2, 2) :: Expression
  expect w is 2 :: Rational
  expect h is 2 :: Rational

  expect
    type Rectangle concrete Rect(w :: Float32, h :: Float32)
    r = (Rect(2, 2) :: Rectangle)
    r
  is
    (
      Rect(2, 2)
    ) :: (
      type Rectangle concrete Rect(w :: Float32, h :: Float32)
      r = (Rect(2, 2) :: Rectangle)
      Rectangle
    )
  end
end

test "C05 types are structural values"
  assert
    type Rectangle concrete Rect(w :: Rational, h :: Rational)
    t = Rectangle
    u = concrete Rect(Rational, Rational)
    (t == u)
  end

  todo assert
    type Box<T> concrete Box(T)
    (Box<String> == (concrete Box(String)))
  end

  todo expect
    type Box<T> concrete Box(T)
    b = (Box("hello") :: Box<String>)
    match b
      Box(text) -> text
    end
  is
    "hello" :: String
  end
end

test "C06 equal spellings can belong to different concrete spaces"
  expect
    type PrimaryColor concrete :Red | :Green | :Blue
    type TicketStatus concrete :Red | :Green
    red = (:Red :: PrimaryColor)
    stopped = (:Red :: TicketStatus)
    (red == stopped)
  fails "E_INCOMPARABLE_TYPES"
end

# Cases below capture specs/approved/type-values.md. Cases that need the new
# kind constructors (ConcreteType, AbstractType, RefinementType) in their setup
# are whole-case todos in tests/specification/type-values/, one per file because
# a file may hold only one todo test. Here only cases with working setup appear.

test "A primitive is already a type value"
  todo expect Int is Int :: PrimitiveType
  assert Int .matches Type
  expect :Int fails "E_QUOTED_PRIMITIVE"
end

test "An independently declared descriptor interops"
  first = (
    type Rectangle concrete Rect(w :: Rational, h :: Rational)
    Rectangle
  )
  second = (
    type Shape concrete Rect(width :: Rational, height :: Rational)
    Shape
  )
  assert first == second
  todo assert first == ConcreteType(Rect(Rational, Rational))
  value = (Rect(2, 3) :: first)
  assert value .matches second
end

test "Independent abstract scopes retain the same member domain"
  left = (
    type Choice abstract Rational | String
    Choice
  )
  right = (
    type Other abstract String | Rational
    Other
  )
  assert left == right
  def pass(t :: Type) t
  assert pass(left) == right
end

test "A declaration registers its accessors"
  type Rectangle concrete Rect(w :: Rational, h :: Rational)
  value = Rect(2, 3) :: Rectangle
  expect value.w is 2 :: Rational
  todo assert Rectangle == ConcreteType(Rect(Rational, Rational))
end

test "A type constructor cannot declare captures"
  todo expect
    ConcreteType(Rect(w :: Rational, h :: Rational))
  fails "ordinary type construction cannot declare captures/accessors"
end

test "Equivalent declarations and accessor collisions still fail"
  type First concrete Rect(w :: Rational)

  expect
    type First concrete Rect(w :: Rational)
    type Second concrete Rect(w :: Rational)
    Second
  fails "E_DUPLICATE_TYPE"

  expect
    def w(x) 99
    value = Rect(2) :: First
    value.w
  fails "E_AMBIGUOUS_CALL"

end

test "Typed overloaded function still works"
  type First concrete Rect(w :: Rational)
  def w(x :: Int) 99
  value = Rect(2) :: First
  expect value.w is 2
end

# specs/approved/type-values.md "A new type needs more than an existing type". A
# primitive atom is already a type value and `type Int` is no longer in the grammar,
# so no declaration, pattern form or constructor wraps one. E_TYPE_DESCRIPTION (the
# invalid-type-description code) is the chosen code for every rejection below.
test "A primitive is not wrapped"
  todo expect
    concrete Int
  fails "E_TYPE_DESCRIPTION"
  todo expect
    abstract Int
  fails "E_TYPE_DESCRIPTION"
  todo expect
    concrete concrete Int
  fails "E_TYPE_DESCRIPTION"
  todo expect
    ConcreteType(Int)
  fails "E_TYPE_DESCRIPTION"
  todo expect
    AbstractType(Int)
  fails "E_TYPE_DESCRIPTION"
  todo expect
    type X concrete Int
    X
  fails "E_TYPE_DESCRIPTION"
  todo expect
    type Y abstract Int
    Y
  fails "E_TYPE_DESCRIPTION"
  assert (concrete Rect(Int, Int)) .matches Type
  assert (abstract Float32 | Float64) .matches Type
end

# specs/approved/type-values.md "Construction and identity": ConcreteType(...) and
# AbstractType(...) never reorder, merge or deduplicate their alternatives.
# Distinctness is the ordinary structural comparison of the resulting values. Today
# the constructor calls are raw Expressions, so the != assertions hold for that
# reason; the todo membership assertions pin that they are Type values.
# `AbstractType(Int | Int)` is not used: AbstractType(Int) is rejected
# ("A primitive is not wrapped"), and an Int | Int alternative list is not a spec example.
test "Kind constructors never reorder or deduplicate"
  assert AbstractType(Int | String) != AbstractType(String | Int)
  assert AbstractType(Int | String | Int) != AbstractType(Int | String)
  assert ConcreteType(:B | :A) != ConcreteType(:A | :B)
  assert ConcreteType(:A | :B | :A) != ConcreteType(:A | :B)
  assert AbstractType(Int | String) == AbstractType(Int | String)
  assert ConcreteType(:B | :A) == ConcreteType(:B | :A)
  todo assert AbstractType(Int | String) .matches Type
  todo assert AbstractType(String | Int) .matches Type
  todo assert ConcreteType(:B | :A) .matches Type
  todo assert ConcreteType(:A | :B | :A) .matches Type
end

# Normalization happens when a `concrete` or `abstract` pattern is evaluated, so
# inputs equal modulo order (and, for abstract, repetition) give equal values. A
# repeated concrete alternative is instead rejected by the existing
# "Concrete duplicate alternatives still reject" contract.
test "Patterns normalize when evaluated"
  assert (abstract Int | String) == (abstract String | Int)
  assert (abstract Int | String | Int) == (abstract String | Int)
  assert (abstract Int | String | Int) == (abstract Int | String)
  assert (concrete :B | :A) == (concrete :A | :B)
  assert (abstract Int | String) .matches Type
  assert (concrete :B | :A) .matches Type
end

# Jonathan: a concrete type cannot be open; open structural facets (**) are abstract.
# Rejected as an invalid type description, like the primitive-wrapping forms above.
test "A concrete type cannot be open"
  todo expect ConcreteType({**}) fails "E_TYPE_DESCRIPTION"
  todo expect
    concrete {**}
  fails "E_TYPE_DESCRIPTION"
end

# specs/approved/type-values.md "A lone primitive is not wrapped": the rule concerns
# a lone primitive, not reuse of an existing type. A union of primitives is valid, and
# an existing type value (an abstract union, a refinement) can be made concrete. The
# `concrete` pattern form works today; the ConcreteType(...) constructor call is
# still a raw Expression (not a Type), so its todo assertions fail on `.matches Type`.
# Value checks use annotated numbers: an unannotated 3 matches both Int and Float.
test "A union or an existing type value can be made concrete"
  todo assert ConcreteType(Rational | String) .matches Type
  assert (concrete Int | Float) .matches Type

  a = abstract Int | Float
  b = concrete a
  assert b .matches Type
  assert (3 :: Int) .matches b
  assert (0.5 :: Float) .matches b
  assert not("x" .matches b)
  todo assert ConcreteType(a) .matches Type

  r = Int .where (n -> n > (0 :: Int))
  s = concrete r
  assert s .matches Type
  assert (3 :: Int) .matches s
  assert not((0 :: Int) .matches s)
  todo assert ConcreteType(r) .matches Type
end
