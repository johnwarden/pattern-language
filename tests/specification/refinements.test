todo test "C07 a refinement preserves its base value"
  def nonZero(n :: Rational) n != 0
  type NonZero pattern Rational .where nonZero
  def keep(x :: NonZero) x

  x = 0.5
  (n :: NonZero) = x
  assert n == x
  expect keep(n) is 0.5 :: NonZero
end

todo test "C08 a separate test assertion supplies no refinement evidence"
  def nonZero(n :: Rational) n != 0
  type NonZero pattern Rational .where nonZero
  def keep(x :: NonZero) x

  assert nonZero(1)

  expect
    def unchecked(x :: Rational) keep(x)
    unchecked(1)
  fails "refinement evidence"
end

todo test "C09 base and refinement overloads overlap"
  def nonZero(n :: Rational) n != 0
  type NonZero pattern Rational .where nonZero

  expect
    def choose(x :: Rational) "base"
    def choose(x :: NonZero) "refined"
    choose(1)
  fails "overlap"
end

todo test "C10 unrelated overload domains can coexist"
  def nonZero(n :: Rational) n != 0
  type NonZero pattern Rational .where nonZero
  def choose(x :: NonZero) "number"
  def choose(x :: String) "string"
  def checked(x :: Rational)
    if nonZero(x) choose(x) else "zero"
  end

  expect checked(1) is "number"
  expect checked(0) is "zero"
  expect choose("hello") is "string"
end
