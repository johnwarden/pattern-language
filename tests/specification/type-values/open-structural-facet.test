# Replaces the legacy examples/expressions "Open structural facet" test, whose
# `def ... type` setup is kept there unchanged for its legacy line. A pattern with
# `**` is an open structural facet, so it is declared `abstract`, never `concrete`
# (specs/approved/retire-legacy-type-definition-syntax.md, "Open patterns migrate to
# abstract"). The facet fixes the Float fields, so their annotations are omitted; the
# open color field keeps its String annotation.
test "Open structural facet"
  type ColoredRect concrete Rect(Float, Float, color: String)
  type Rectangular abstract Rect(w :: Float, h :: Float, **)
  r = Rect(2, 3, color: "black") :: ColoredRect
  (p :: Rectangular) = r

  expect p is Rect(2, 3, color: "black") :: ColoredRect
  expect p.w is 2 :: Float
  expect p.h is 3 :: Float

  assert p == r
  expect toString(Rectangular)(p) is "Rect(2, 3, color: \"black\" :: String)" :: String

  assert parse(Rectangular)(toString(Rectangular)(p)) == r
end
