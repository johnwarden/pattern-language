test "Overlapping UnionType keeps Float32 and Float64 identities"
  def EitherFloat UnionType(type Float32, type Float64)
  (a :: EitherFloat) = float32(0.5)
  (b :: EitherFloat) = float64(0.5)

  expect a is 0.5 :: Float32
  expect b is 0.5 :: Float64
  assert a .matches Float32
  assert b .matches Float64
  assert a != b
  assert parse(EitherFloat)(toString(EitherFloat)(a)) == a
end

test "Union text omits :: when untagged print reconstructs the same member and value"
  def Unique UnionType(type Int, type String)
  (x :: Unique) = 3 :: Int
  omitted = toString(Unique)(x)

  expect omitted is "3" :: String
  assert parse(Unique)(omitted) == x

  def Mixed UnionType(type Int, type Float)
  (y :: Mixed) = 0.5 :: Float
  uniqueFloat = toString(Mixed)(y)

  expect uniqueFloat is "0.5" :: String
  assert parse(Mixed)(uniqueFloat) == y
end

test "Union text keeps :: when untagged print is ambiguous or a different value"
  def EitherFloat UnionType(type Float32, type Float64)
  (a :: EitherFloat) = float32(0.5)
  (c :: EitherFloat) = float64(0.1)
  ambiguous = toString(EitherFloat)(a)
  differentValue = toString(EitherFloat)(c)

  expect ambiguous is "0.5 :: Float32" :: String
  expect differentValue is "0f0.1 :: Float64" :: String
  assert parse(EitherFloat)(ambiguous) == a
  assert parse(EitherFloat)(differentValue) == c

  expect
    parse(EitherFloat)("0.5")
  fails "E_AMBIGUOUS_VALUE_DESIGNATOR"

  expect
    parse(EitherFloat)("0.1")
  fails "E_PATTERN_MISMATCH"
end

test "Unannotated overlapping numeric values stay ambiguous"
  def EitherFloat UnionType(type Float32, type Float64)

  expect
    (x :: EitherFloat) = 0.5
    x
  fails "E_AMBIGUOUS_VALUE_DESIGNATOR"
end

test "UnionType text distinguishes Float64 from Float"
  t = UnionType(Float32, Float64)

  expect toString(Type)(t) is "UnionType(Float32, Float64)" :: String
  assert parse(Type)(toString(Type)(t)) == t
end

test "Overlapping option unions construct; unannotated None is ambiguous"
  expect UnionType(Int?, String?) is UnionType(Struct(Int | :None), Struct(:None | String)) :: Type

  expect
    def U UnionType(Int?, String?)
    (x :: U) = :None
    x
  fails "E_AMBIGUOUS_VALUE_DESIGNATOR"
end

test "Overlapping numeric and constructor unions construct"
  expect UnionType(Int, Float) is UnionType(Float, Int) :: Type
  assert UnionType(Int, Int) == UnionType(Int)

  expect
    def A type :X(Int)
    def B type :X(Float)
    UnionType(A, B)
  is UnionType(Struct(X(Float)), Struct(X(Int))) :: Type

  expect
    def U UnionType(type Int, type Float)
    (x :: U) = 3
    x
  fails "E_AMBIGUOUS_VALUE_DESIGNATOR"
end

test "Same-space refinement unions reject without running predicates"
  expect
    def P Int .where (n -> panic("must not run"))
    unionType P | Int
  fails "E_REFINED_UNION"
end

# Alternatives with equal compiled type values are one alternative.
test "Repeated alternatives in a type are one alternative"
  def Bad type :A | :A
  assert Bad == (type :A)
  type X concrete :D | :D
  assert X == (concrete :D)
  type Y concrete :C | :A | :B | :A | :C
  assert Y == (concrete :A | :B | :C)
  assert :D .matches X
  expect
    (x :: Y) = :B
    x
  is B
end

test "Type construction removes equal alternatives with different spellings"
  i = Int
  assert (type Int | i) == Int
  assert (type Int | String | i) == (type Int | String)
  assert (type :Box(Int) | Box(Int)) == (type Box(Int))
  assert (type 1 | 1.0) == (type 1)
  one = 1 :: Int
  assert (type 1 | one) == (type 1)
  assert Struct(:(Box(Int) | Box(Int))) != (type Box(Int))
  a = type :A
  assert (type :A) == a
  assert (type :A | a) == a
  assert (type a | :A) == a
  assert (type a | :A | :B) == (type :A | :B)
end

test "A factory result and a quoted head normalize when their types are equal"
  def Box(T :: Type) type :Box(T)
  assert (type :Box(Int)) == Box(Int)
  assert (type :Box(Int) | Box(Int)) == Box(Int)
  assert (type Box(Int) | :Box(Int)) == Box(Int)
  assert (type Box(Int) | :Box(Int) | :Absent) == (type :Box(Int) | :Absent)
end

test "Type alternatives keep unequal explicit wrappers"
  wrapped = Struct(Int)
  assert wrapped != Int
  assert (type Int | wrapped) != Int
  assert (type wrapped | wrapped) == wrapped
end

test "Renaming a capture does not create a second type alternative"
  def Shape type :Circle(r :: Float) | Circle(radius :: Float)
  assert Shape == (type Circle(Float))
  shape = Circle(1 :: Float) :: Shape
  expect shape.r is 1 :: Float
end

test "Recursive alternatives normalize after the full type is available"
  def Chain type :Nil | :Cons(Int, Chain) | Cons(Int, Chain)
  assert :Nil .matches Chain
  assert Cons(1, :Nil) .matches Chain
end

test "Overlapping abstract facet members retain spaces"
  def Colored type :Rect(Float, Float, color: String)
  def Rectangular type :Rect(w :: Float, h :: Float, **)

  expect UnionType(type Rectangular, type Colored) is UnionType(Facet(Apply(:Rect, OpenFields(Fields(Float, Float), labels: True, positional: False))), Struct(Rect(Float, Float, color: String))) :: Type
end
