test "Float64 is a distinct primitive and float64 converts"
  expect float64(0.5) is 0.5 :: Float64
  expect float32(0.5) is 0.5 :: Float32
  observed = type Float64
  expect observed is Float64 :: Type
  expect
    type Num
  fails "E_UNBOUND_TYPE"
  expect
    type Int64
  fails "E_UNBOUND_TYPE"

  expect
    float32(0.5) == float64(0.5)
  fails "E_INCOMPARABLE_TYPES"
end

test "Overlapping UnionType keeps Float32 and Float64 identities"
  def EitherFloat UnionType(type Float32, type Float64)
  (a :: EitherFloat) = float32(0.5)
  (b :: EitherFloat) = float64(0.5)

  expect a is 0.5 :: Float32
  expect b is 0.5 :: Float64
  assert a .matches Float32
  assert b .matches Float64
  assert a != b
  assert parse(EitherFloat)(toString(EitherFloat)(a)) == a
end

test "Union text omits :: when untagged print reconstructs the same member and value"
  def Unique UnionType(type Int, type String)
  (x :: Unique) = 3 :: Int
  omitted = toString(Unique)(x)

  expect omitted is "3" :: String
  assert parse(Unique)(omitted) == x

  def Mixed UnionType(type Int, type Float)
  (y :: Mixed) = 0.5 :: Float
  uniqueFloat = toString(Mixed)(y)

  expect uniqueFloat is "0.5" :: String
  assert parse(Mixed)(uniqueFloat) == y
end

test "Union text keeps :: when untagged print is ambiguous or a different value"
  def EitherFloat UnionType(type Float32, type Float64)
  (a :: EitherFloat) = float32(0.5)
  (c :: EitherFloat) = float64(0.1)
  ambiguous = toString(EitherFloat)(a)
  differentValue = toString(EitherFloat)(c)

  expect ambiguous is "0.5 :: Float32" :: String
  expect differentValue is "0x1.999999999999Ap-4 :: Float64" :: String
  assert parse(EitherFloat)(ambiguous) == a
  assert parse(EitherFloat)(differentValue) == c

  expect
    parse(EitherFloat)("0.5")
  fails "E_AMBIGUOUS_PATTERN"

  expect
    parse(EitherFloat)("0.1")
  fails "E_PATTERN_MISMATCH"
end

test "Unannotated overlapping numeric values stay ambiguous"
  def EitherFloat UnionType(type Float32, type Float64)

  expect
    (x :: EitherFloat) = 0.5
    x
  fails "E_AMBIGUOUS_PATTERN"
end

test "UnionType text distinguishes Float64 from Float"
  t = UnionType(Float32, Float64)

  # Legacy: the exact old UnionType(...) text. The todo is the ordinary value text of AbstractType(Float32 | Float64); t's setup moves to AbstractType with the implementation.
  legacy expect toString(Type)(t) is "UnionType(Float32, Float64)" :: String
  todo expect toString(Type)(t) is "AbstractType(Float32 | Float64)" :: String
  assert parse(Type)(toString(Type)(t)) == t
end

test "Overlapping option unions construct; unannotated None is ambiguous"
  legacy expect UnionType(Int?, String?) is UnionType(Type(Int | :None), Type(:None | String)) :: Type
  todo expect AbstractType(Int? | String?) is AbstractType(ConcreteType(Int | :None) | ConcreteType(:None | String)) :: Type

  expect
    def U UnionType(Int?, String?)
    (x :: U) = :None
    x
  fails "E_AMBIGUOUS_PATTERN"
end

test "Overlapping numeric and constructor unions construct"
  # Legacy: UnionType reorders and deduplicates members; AbstractType(...) does not, so no replacement is specified.
  legacy expect UnionType(Int, Float) is UnionType(Float, Int) :: Type
  legacy assert UnionType(Int, Int) == UnionType(Int)

  # Legacy (not marked): UnionType(A, B) reorders members; the inventory format cannot hold this multi-line subject.
  expect
    def A type :X(Int)
    def B type :X(Float)
    UnionType(A, B)
  is UnionType(Type(X(Float)), Type(X(Int))) :: Type

  expect
    def U UnionType(type Int, type Float)
    (x :: U) = 3
    x
  fails "E_AMBIGUOUS_PATTERN"
end

test "Same-space refinement unions reject without running predicates"
  expect
    def P Int .where (n -> panic("must not run"))
    unionType P | Int
  fails "E_REFINED_UNION"
end

test "Concrete duplicate alternatives still reject"
  expect
    def Bad type :A | :A
    0
  fails "E_AMBIGUOUS_PATTERN"
end
