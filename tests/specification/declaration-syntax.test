test "Concrete declarations retain recursive declaration groups"
  assert
    type Left concrete :StopLeft | L(Right)
    type Right concrete :StopRight | R(Left)
    (value :: Left) = L(R(:StopLeft))
    parse(Left)(toString(Left)(value)) == value
  end
end

# Near-term D08 guards. Destination no-op / disjoint-group rules are proposed
# in D21 and covered in the type-values / named-function-values fences.

test "Equivalent concrete declarations keep the duplicate-type guard"
  expect
    type First concrete Box(value :: NumericValue)
    type Second concrete Box(item :: NumericValue)
    Second
  fails "E_DUPLICATE_TYPE"
end

test "Concrete declaration accessors keep collision errors"
  expect
    type Rectangle concrete Rect(w :: NumericValue, h :: NumericValue)
    def w(x) 99
    r = Rect(2, 3) :: Rectangle
    r.w
  fails "E_AMBIGUOUS_CALL"
end
