test "C11 projection is one explicit concrete boundary"
  todo expect
    type Small struct String
    type Wrapped struct Small
    (w :: Wrapped) = "hello" :: Small
    match w
      (s :: Small) -> s
    end
  is
    (
      "hello"
    ) :: (
      type Small struct String
      type Wrapped struct Small
      (w :: Wrapped) = "hello" :: Small
      Small
    )
  end

  todo expect
    type Small struct String
    type Wrapped struct Small
    (w :: Wrapped) = "hello" :: Small
    match w
      (s :: Small) -> match s
        (text :: String) -> text
      end
    end
  is
    (
      "hello"
    ) :: String
  end

  todo expect
    type Small struct String
    type Wrapped struct Small
    (w :: Wrapped) = "hello" :: Small
    match w
      (text :: String) -> text
    end
  fails "the immediate base of Wrapped is Small"

  todo expect
    type Small struct String
    type Wrapped struct Small
    (w :: Wrapped) = "hello" :: Small
    (direct :: String) = w
    direct
  fails "ordinary binding does not unwrap Wrapped"

  todo expect
    type Small struct String
    type Wrapped struct Small
    (w :: Wrapped) = "hello" :: Small
    def consume(x :: String) x
    consume(w)
  fails "dispatch does not unwrap Wrapped"
end

test "C12 designation is recursive only when unambiguous"
  todo expect
    type Option<T> concrete T | :None
    (outer :: Option<Option<String>>) = "Hello"
    text = match outer
      (inner :: Option<String>) -> match inner
        (s :: String) -> s
        :None -> "inner absent"
      end
      :None -> "outer absent"
    end
    text
  is
    (
      "Hello"
    ) :: (
      type Option<T> concrete T | :None
      (outer :: Option<Option<String>>) = "Hello"
      text = match outer
        (inner :: Option<String>) -> match inner
          (s :: String) -> s
          :None -> "inner absent"
        end
        :None -> "outer absent"
      end
      String
    )
  end

  todo assert
    type Option<T> concrete T | :None
    (outer :: Option<Option<String>>) = :None
    (explicitOuter :: Option<Option<String>>) = :None :: Option<Option<String>>
    (inner :: Option<Option<String>>) = :None :: Option<String>

    assert outer == explicitOuter
    (outer != inner)
  end

  todo expect
    type Option<T> concrete T | :None
    (outer :: Option<Option<String>>) = "Hello"
    text = match outer
      (inner :: Option<String>) -> match inner
        (s :: String) -> s
        :None -> "inner absent"
      end
      :None -> "outer absent"
    end
    def extract(x :: Option<String>)
      match x s :: String
      s
    end
    extract("Hello" :: Option<String>)
  fails "String extraction is not guaranteed for every Option<String>"
end

test "C13 abstract union retains overlapping numeric members"
  assert
    domain = abstract Float32 | Float64
    (domain == (unionType Float32 | Float64))
  end

  expect
    type EitherFloat abstract Float32 | Float64
    (a :: EitherFloat) = float32(0.5)
    (b :: EitherFloat) = float64(0.5)
    a
  is
    (
      0.5
    ) :: (
      type EitherFloat abstract Float32 | Float64
      (a :: EitherFloat) = float32(0.5)
      (b :: EitherFloat) = float64(0.5)
      Float32
    )
  end

  expect
    type EitherFloat abstract Float32 | Float64
    (a :: EitherFloat) = float32(0.5)
    (b :: EitherFloat) = float64(0.5)
    b
  is
    (
      0.5
    ) :: (
      type EitherFloat abstract Float32 | Float64
      (a :: EitherFloat) = float32(0.5)
      (b :: EitherFloat) = float64(0.5)
      Float64
    )
  end

  assert
    type EitherFloat abstract Float32 | Float64
    (a :: EitherFloat) = float32(0.5)
    (b :: EitherFloat) = float64(0.5)
    text = toString(EitherFloat)(a)
    (parse(EitherFloat)(text) == a)
  end

  todo assert
    type EitherFloat pattern Float32 | Float64
    domain = pattern Float32 | Float64
    (domain === EitherFloat)
  end

  todo expect
    type EitherFloat pattern Float32 | Float64
    (a :: EitherFloat) = float32(0.5)
    (b :: EitherFloat) = float64(0.5)
    a
  is
    (
      0.5
    ) :: (
      type EitherFloat pattern Float32 | Float64
      (a :: EitherFloat) = float32(0.5)
      (b :: EitherFloat) = float64(0.5)
      Float32
    )
  end

  todo expect
    type EitherFloat pattern Float32 | Float64
    (a :: EitherFloat) = float32(0.5)
    (b :: EitherFloat) = float64(0.5)
    b
  is
    (
      0.5
    ) :: (
      type EitherFloat pattern Float32 | Float64
      (a :: EitherFloat) = float32(0.5)
      (b :: EitherFloat) = float64(0.5)
      Float64
    )
  end

  todo assert
    type EitherFloat pattern Float32 | Float64
    (a :: EitherFloat) = float32(0.5)
    (b :: EitherFloat) = float64(0.5)
    text = toString(EitherFloat)(a)
    (parse(EitherFloat)(text) === a)
  end
end

test "C14 unambiguous is a separate grammar requirement"
  todo assert
    type Token unambiguous pattern Rational | String
    (n :: Token) = 0.5
    (parse(Token)(toString(Token)(n)) == n)
  end

  todo expect
    type Token unambiguous pattern Rational | String
    (n :: Token) = 0.5
    assert parse(Token)(toString(Token)(n)) == n
    type Bad unambiguous pattern Float32 | Float64
    Bad
  fails "the same numeric spelling admits more than one interpretation"
end

test "C15 facet intersection preserves concrete identity and fields"
  todo assert
    type Card struct {width: Float32, height: Float32, color: String}
    type Rectangular pattern {width: Float32, height: Float32, **}
    type Colored pattern {color: String, **}
    type ColoredRectangle pattern Rectangular & Colored
    card = ({width: 0.5, height: 1, color: "blue"} :: Card)
    (view :: ColoredRectangle) = card
    (view === card)
  end

  todo expect
    type Card struct {width: Float32, height: Float32, color: String}
    type Rectangular pattern {width: Float32, height: Float32, **}
    type Colored pattern {color: String, **}
    type ColoredRectangle pattern Rectangular & Colored
    card = ({width: 0.5, height: 1, color: "blue"} :: Card)
    (view :: ColoredRectangle) = card
    assert view === card
    view
  is
    (
      {width: 0.5, height: 1, color: "blue"}
    ) :: (
      type Card struct {width: Float32, height: Float32, color: String}
      type Rectangular pattern {width: Float32, height: Float32, **}
      type Colored pattern {color: String, **}
      type ColoredRectangle pattern Rectangular & Colored
      card = ({width: 0.5, height: 1, color: "blue"} :: Card)
      (view :: ColoredRectangle) = card
      assert view === card
      Card
    )
  end
end
