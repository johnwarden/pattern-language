test "C11 projection is one explicit concrete boundary"
  todo expect
    small = n -> (n == 0)
    smaller = n -> True
    type Small concrete Rational .where small
    type Wrapped concrete Small .where smaller
    (w :: Wrapped) = 0
    match w s :: Small
    match s r :: Rational
    r
  is
    (
      0
    ) :: Rational
  end

  todo expect
    small = n -> (n == 0)
    smaller = n -> True
    type Small concrete Rational .where small
    type Wrapped concrete Small .where smaller
    (w :: Wrapped) = 0
    match w s :: Small
    match s r :: Rational
    (direct :: Rational) = w
    direct
  fails "ordinary binding does not unwrap Wrapped"

  todo expect
    small = n -> (n == 0)
    smaller = n -> True
    type Small concrete Rational .where small
    type Wrapped concrete Small .where smaller
    (w :: Wrapped) = 0
    match w s :: Small
    match s r :: Rational
    match w direct :: Rational
    direct
  fails "the immediate base of Wrapped is Small"

  todo expect
    small = n -> (n == 0)
    smaller = n -> True
    type Small concrete Rational .where small
    type Wrapped concrete Small .where smaller
    (w :: Wrapped) = 0
    match w s :: Small
    match s r :: Rational
    def consume(x :: Rational) x
    consume(w)
  fails "dispatch does not unwrap Wrapped"
end

test "C12 designation is recursive only when unambiguous"
  expect
    type Option<T> concrete T | :None
    (outer :: Option<Option<String>>) = "Hello"
    text = match outer
      (inner :: Option<String>) -> match inner
        (s :: String) -> s
        :None -> "inner absent"
      end
      :None -> "outer absent"
    end
    text
  is
    (
      "Hello"
    ) :: (
      type Option<T> concrete T | :None
      (outer :: Option<Option<String>>) = "Hello"
      text = match outer
        (inner :: Option<String>) -> match inner
          (s :: String) -> s
          :None -> "inner absent"
        end
        :None -> "outer absent"
      end
      String
    )
  end

  assert
    type Option<T> concrete T | :None
    (outer :: Option<Option<String>>) = :None
    (explicitOuter :: Option<Option<String>>) = :None :: Option<Option<String>>
    (inner :: Option<Option<String>>) = :None :: Option<String>
    (outer == explicitOuter)
  end

  assert
    type Option<T> concrete T | :None
    (outer :: Option<Option<String>>) = :None
    (explicitOuter :: Option<Option<String>>) = :None :: Option<Option<String>>
    (inner :: Option<Option<String>>) = :None :: Option<String>
    (outer != inner)
  end

  todo expect
    type Option<T> concrete T | :None
    (outer :: Option<Option<String>>) = "Hello"
    text = match outer
      (inner :: Option<String>) -> match inner
        (s :: String) -> s
        :None -> "inner absent"
      end
      :None -> "outer absent"
    end
    def extract(x :: Option<String>)
      match x s :: String
      s
    end
    extract("Hello" :: Option<String>)
  fails "String extraction is not guaranteed for every Option<String>"
end

test "C13 abstract union retains overlapping numeric members"
  assert
    domain = abstract Float32 | Float64
    (domain == (unionType Float32 | Float64))
  end

  expect
    type EitherFloat abstract Float32 | Float64
    (a :: EitherFloat) = float32(0.5)
    (b :: EitherFloat) = float64(0.5)
    a
  is
    (
      0.5
    ) :: (
      type EitherFloat abstract Float32 | Float64
      (a :: EitherFloat) = float32(0.5)
      (b :: EitherFloat) = float64(0.5)
      Float32
    )
  end

  expect
    type EitherFloat abstract Float32 | Float64
    (a :: EitherFloat) = float32(0.5)
    (b :: EitherFloat) = float64(0.5)
    b
  is
    (
      0.5
    ) :: (
      type EitherFloat abstract Float32 | Float64
      (a :: EitherFloat) = float32(0.5)
      (b :: EitherFloat) = float64(0.5)
      Float64
    )
  end

  assert
    type EitherFloat abstract Float32 | Float64
    (a :: EitherFloat) = float32(0.5)
    (b :: EitherFloat) = float64(0.5)
    text = toString(EitherFloat)(a)
    (parse(EitherFloat)(text) == a)
  end
end

test "C14 unambiguous is a separate grammar requirement"
  todo assert
    type Token unambiguous abstract Rational | String
    (n :: Token) = 0.5
    (parse(Token)(toString(Token)(n)) == n)
  end

  todo expect
    type Token unambiguous abstract Rational | String
    (n :: Token) = 0.5
    assert parse(Token)(toString(Token)(n)) == n
    type Bad unambiguous abstract Float32 | Float64
    Bad
  fails "the same numeric spelling admits more than one interpretation"
end

test "C15 facet intersection preserves concrete identity and fields"
  todo assert
    type Card concrete {width: Float32, height: Float32, color: String}
    type Rectangular abstract {width: Float32, height: Float32, **}
    type Colored abstract {color: String, **}
    type ColoredRectangle abstract Rectangular & Colored
    card = ({width: 0.5, height: 1, color: "blue"} :: Card)
    (view :: ColoredRectangle) = card
    (view == card)
  end

  todo expect
    type Card concrete {width: Float32, height: Float32, color: String}
    type Rectangular abstract {width: Float32, height: Float32, **}
    type Colored abstract {color: String, **}
    type ColoredRectangle abstract Rectangular & Colored
    card = ({width: 0.5, height: 1, color: "blue"} :: Card)
    (view :: ColoredRectangle) = card
    assert view == card
    view
  is
    (
      {width: 0.5, height: 1, color: "blue"}
    ) :: (
      type Card concrete {width: Float32, height: Float32, color: String}
      type Rectangular abstract {width: Float32, height: Float32, **}
      type Colored abstract {color: String, **}
      type ColoredRectangle abstract Rectangular & Colored
      card = ({width: 0.5, height: 1, color: "blue"} :: Card)
      (view :: ColoredRectangle) = card
      assert view == card
      Card
    )
  end
end
