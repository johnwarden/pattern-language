test "C16 named declarations install accessors; plain construction cannot declare them"
  def Rectangle type :Rect(w :: Rational, h :: Rational)
  r = Rect(2, 3) :: Rectangle
  expect r.w result 2 :: Rational

  expect
    t = type :Rect(width :: Rational, height :: Rational)
    t
  error "ordinary type construction cannot declare captures/accessors"

  expect
    t = type :Rect(width: Rational, height: Rational)
    (labeled :: t) = Rect(width: 2, height: 3)
    labeled.width
  error "unbound name"
end

test "C05 named types equal capture-free type values"
  def Rectangle type :Rect(w :: Rational, h :: Rational)
  t = Rectangle
  u = type :Rect(Rational, Rational)
  assert t == u
  def Box(T :: Type) type :Box(T)
  assert Box(String) == (type :Box(String))
  b = :Box("hello") :: Box(String)
  text = match b
    :Box(value) -> value
  end
  assert text == "hello"
end

test "C18 independent lexical scopes interoperate structurally"
  produced = (
    def Option(T :: Type) type :None | Some(T)
    Some("hello") :: Option(String)
  )
  independent = (
    def Optional(T :: Type) type :None | Some(T)
    Some("hello") :: Optional(String)
  )
  assert produced == independent
  consumed = (
    def LocalOption(T :: Type) type :None | Some(T)
    def read(x :: LocalOption(String))
      match x
        Some(s) -> s
        :None -> "absent"
      end
    end
    read(produced)
  )
  assert consumed == "hello"
end

test "C16 declarations own accessor products"
  todo expect
    type Rectangle concrete Rect(w :: Rational, h :: Rational)
    r = (Rect(2, 3) :: Rectangle)
    r.w
  result
    (
      2
    ) :: (
      type Rectangle concrete Rect(w :: Rational, h :: Rational)
      r = (Rect(2, 3) :: Rectangle)
      Rational
    )
  end

  todo expect
    type Rectangle concrete Rect(w :: Rational, h :: Rational)
    r = (Rect(2, 3) :: Rectangle)
    t = concrete Rect(width :: Rational, height :: Rational)
    t
  error "ordinary type construction cannot declare captures/accessors"
end

test "C17 defaults belong to bindings and explicit factories"
  todo expect
    type Rectangle concrete Rect(w :: Float32, h :: Float32, color: String)
    def rectangle(w :: Float32, h :: Float32, color: String = "black")
      (Rect(w, h, color: color) :: Rectangle)
    end
    rectangle(2, 3)
  result
    (
      Rect(2, 3, color: "black")
    ) :: (
      type Rectangle concrete Rect(w :: Float32, h :: Float32, color: String)
      def rectangle(w :: Float32, h :: Float32, color: String = "black")
        (Rect(w, h, color: color) :: Rectangle)
      end
      Rectangle
    )
  end

  todo expect
    type Rectangle concrete Rect(w :: Float32, h :: Float32, color: String)
    def rectangle(w :: Float32, h :: Float32, color: String = "black")
      (Rect(w, h, color: color) :: Rectangle)
    end
    (Rect(2, 3) :: Rectangle)
  error "required color field is absent"

  todo expect
    type Rectangle concrete Rect(w :: Float32, h :: Float32, color: String)
    def rectangle(w :: Float32, h :: Float32, color: String = "black")
      (Rect(w, h, color: color) :: Rectangle)
    end
    type Invalid concrete Rect(color: String = "black")
    Invalid
  error "defaults are forbidden in type descriptions"
end

test "C18 equivalent independently named descriptors interoperate"
  todo assert
    produced = (
      type Option<T> concrete :None | Some(T)
      (Some("hello") :: Option<String>)
    )
    independent = (
      type Optional<T> concrete :None | Some(T)
      (Some("hello") :: Optional<String>)
    )
    (produced == independent)
  end

  todo expect
    produced = (
      type Option<T> concrete :None | Some(T)
      (Some("hello") :: Option<String>)
    )
    independent = (
      type Optional<T> concrete :None | Some(T)
      (Some("hello") :: Optional<String>)
    )
    assert produced == independent
    consumed = (
      type LocalOption<T> concrete :None | Some(T)
      def read(x :: LocalOption<String>)
        match x
          Some(s) -> s
          :None -> "absent"
        end
      end
      read(produced)
    )
    consumed
  result
    (
      "hello"
    ) :: (
      produced = (
        type Option<T> concrete :None | Some(T)
        (Some("hello") :: Option<String>)
      )
      independent = (
        type Optional<T> concrete :None | Some(T)
        (Some("hello") :: Optional<String>)
      )
      assert produced == independent
      consumed = (
        type LocalOption<T> concrete :None | Some(T)
        def read(x :: LocalOption<String>)
          match x
            Some(s) -> s
            :None -> "absent"
          end
        end
        read(produced)
      )
      String
    )
  end
end
