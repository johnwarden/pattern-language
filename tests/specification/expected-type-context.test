# Expected-type context (see specs/approved/type-values.md examples using `concrete a`).
# An ambiguous literal is rejected today with E_AMBIGUOUS_PATTERN. Jonathan's direction
# is probably E_AMBIGUOUS_VALUE with a message listing the interpretations; not final,
# so each legacy assertion (must pass) has a same-subject todo. Only the interpretation
# substrings are pinned, not any "please specify" wording.
test "An ambiguous numeric literal lists its interpretations"
  b = abstract Int | Float
  legacy expect 3 .matches b fails "E_AMBIGUOUS_PATTERN"
  todo expect 3 .matches b fails "E_AMBIGUOUS_VALUE"
  todo expect 3 .matches b fails "3 :: Int"
  todo expect 3 .matches b fails "3 :: Float"

  legacy expect
    (x :: b) = 3
    x
  fails "E_AMBIGUOUS_PATTERN"
  todo expect
    (x :: b) = 3
    x
  fails "E_AMBIGUOUS_VALUE"
  todo expect
    (x :: b) = 3
    x
  fails "3 :: Int"
  todo expect
    (x :: b) = 3
    x
  fails "3 :: Float"
end

test "An ambiguous absence between peer options is an ambiguous value"
  type Foo concrete String? | Float?
  legacy expect
    (x :: Foo) = :None
    x
  fails "E_AMBIGUOUS_PATTERN"
  todo expect
    (x :: Foo) = :None
    x
  fails "E_AMBIGUOUS_VALUE"
end

# A refinement of Int is run over explicit Ints; a literal Rational in its predicate
# is an incomparable type (confirmed by Jonathan; no implicit literal conversion).
test "A refinement of Int runs over explicit Ints only"
  r = Int .where (n -> n > 0)
  expect 0 .matches r fails "E_INCOMPARABLE_TYPES"
  expect (0 :: Int) .matches r fails "E_INCOMPARABLE_TYPES"

  r2 = Int .where (n -> n > (0 :: Int))
  assert not((0 :: Int) .matches r2)
  assert (2 :: Int) .matches r2
end
