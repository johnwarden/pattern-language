test "C01 intrinsic primitive values"
  expect True is True :: Bool
  expect False is False :: Bool
  expect Int is Int :: ReservedSymbol
  expect "hello" is "hello" :: String
  expect 5 is 5 :: Rational
  expect :Widget is Widget :: UpperCamelSymbol
  expect :foo is foo :: LowerCamelSymbol
  expect :Symbol is Symbol :: UpperCamelSymbol
  assert Int .matches ReservedSymbol
  assert not(Int .matches UpperCamelSymbol)
  assert not(Int .matches Symbol)
  assert not(True .matches UpperCamelSymbol)
  assert not(True .matches ReservedSymbol)
  assert False .matches Bool
  assert :Widget .matches UpperCamelSymbol
  assert not(:Widget .matches ReservedSymbol)
  assert :Widget .matches Symbol
  assert :foo .matches Symbol
  assert (type Symbol) == (unionType LowerCamelSymbol | UpperCamelSymbol | UpperSnakeSymbol | PunctuationSymbol)
  assert Int == (type Int)
  assert Float == (type Float)
  assert Bool == (type Bool)
  legacy expect
    type Bool
  is Bool :: Type
  todo expect
    type Bool
  is Bool :: PrimitiveType
  todo expect PrimitiveType is PrimitiveType :: PrimitiveType
end

test "Literal and computed Booleans share one Bool type"
  assert True == (1 == 1)
  assert not(True != (1 == 1))
  assert (1 == 1) == True
  assert not((1 == 1) != True)
  assert True != (1 == 2)
  assert (1 == 2) != True
  assert False != (1 == 1)
  assert (1 == 1) != False
  assert 1 != 2
  assert not(False != (1 == 2))
  assert (1 == 2) == False
  assert not((1 == 2) != False)
  assert 1 == 1
  assert not(1 != 1)
  assert 1 < 2
  assert 2 > 1
  assert 1 <= 2
  assert 2 >= 1
  assert isInt64(3)
  assert 2 .matches Int
  expect
    True == Int
  fails "E_INCOMPARABLE_TYPES"
  t = type True | False
  assert parse(Type)(toString(Type)(t)) == t
end

test "Match arms use bare True and False"
  expect
    match 1 == 1
      True -> "yes"
      False -> "no"
    end
  is "yes" :: String
  expect
    match True
      True -> "yes"
      False -> "no"
    end
  is "yes" :: String
  expect
    match 1 == 2
      True -> "yes"
      False -> "no"
    end
  is "no" :: String
  expect
    match 1 == 1
      :True -> "yes"
      _ -> "no"
    end
  fails "E_QUOTED_PRIMITIVE"
  expect
    match False
      :False -> "yes"
      _ -> "no"
    end
  fails "E_QUOTED_PRIMITIVE"
end

test "Quoted primitive names in Code"
  expect :Int fails "E_QUOTED_PRIMITIVE"
  expect :True fails "E_QUOTED_PRIMITIVE"
  expect Int == :Int fails "E_QUOTED_PRIMITIVE"
  expect :String(:A) fails "E_QUOTED_PRIMITIVE"
  expect
    type :Int
  fails "E_QUOTED_PRIMITIVE"
  expect
    type :String(:A)
  fails "E_QUOTED_PRIMITIVE"
  expect :(Int) is Int :: Expression
  expect parse(Code)(":Int") is :Int :: Code
  expect parse(Code)(":(Int)") is :(Int) :: Code
  todo expect parse(Code)(":Foo") is :Foo :: QuotedSymbol
  todo expect parse(Code)(":(Int)") is :(Int) :: QuotedSymbol
  todo expect parse(Code)(":Int") fails "a quoted primitive is not a Symbol"
end

test "String operations keep intrinsic String identity"
  expect "a" + "b" is "ab" :: String
  expect toString(Rational)(0.1) is "0.1" :: String
  s = "x"
  expect s is "x" :: String
  def echo(t) t
  expect echo("hi") is "hi" :: String
  (first, second) = ("a", "b")
  expect first is "a" :: String
  expect second is "b" :: String
  assert ["hello"] .matches (type [_... :: String*])
  assert "hello" .matches String
  expect
    "hello" :: Int
  fails "expected Int"
  expect
    1 < "a"
  fails "E_INCOMPARABLE_TYPES"
  expect parse(String)(toString(String)("hi")) is "hi" :: String
end

test "C02 exact Rational literal meanings"
  expect 0.1 is 0.1 :: Rational
  expect 0f0.5 is 0.5 :: Rational
  expect 0f0.1 is 0x1.999999999999Ap-4 :: Rational
  assert 0f0.1 != 0.1
  assert 0xFp8 == 0b1111p8
end

test "C03 exact designation differs from rounding"
  expect 0.5 :: Float32 is 0.5 :: Float32
  expect float32(0.5) is 0.5 :: Float32
  todo expect 0f0.5 :: Decimal32 is 0.5 :: Decimal32
  expect 0f0.1 :: Float64 is 0x1.999999999999Ap-4 :: Float64
  expect 0.1 :: Float64 fails "not exactly representable as Float64"
  expect
    (0.1 :: Float32)
  fails "not exactly representable as Float32"
  assert 0.5 .matches Float32
  assert not(0.1 .matches Float32)
  assert 0.5 .matches Float
  assert not(0.1 .matches Float)
  assert 0f0.1 .matches Float
  expect 0.5 :: Float is 0.5 :: Float

  todo expect
    (0.5 :: Int16)
  fails "not an integer"
end
