test "Postfix punctuation distinct from prefix application"
  def PostfixAt type String@
  def PrefixAt type
    @(String)
  end
  (x :: PostfixAt) = "foo"@
  (y :: PrefixAt) = @"bar"

  expect x == y fails "E_INCOMPARABLE_TYPES"
  s = match x
    (captured :: String)@ -> captured
  end
  t = match y
    @(captured :: String) -> captured
  end
  expect s is "foo" :: String
  expect t is "bar" :: String
end

test "Source optional convention has unwrapped present values"
  expect "x" :: String? is "x" :: String?
  expect :None :: String? is None :: String?
  expect Some("x") :: String? fails "E_PATTERN_MISMATCH"
  expect "x"? fails "E_NO_METHOD"
end

test "Ordinary definitions give postfix operators meaning"
  def (n :: NumericValue)@ n + 1
  expect 2@ is 3 :: NumericValue
  prefix = @(2)
  expect prefix is
    @(2) :: Expression
  end
end

test "Another source postfix type convention"
  def (T :: Type)~ type T | :Absent
  expect 3 :: Int~ is 3 :: Int~
  expect :Absent :: Int~ is Absent :: Int~
end

test "Postfix type descriptions preserve matching after round trip"
  def T type Int@
  t = parse(Type)(toString(Type)(T))
  assert T == t
  assert 1@ .matches T
  assert 1@ .matches t
  assert not(Postfix(:@, 1) .matches t)
end

test "Postfix values can be type factory arguments"
  def Box(x) type :Box(x)
  t = Box(1@)
  assert t == parse(Type)(toString(Type)(t))
  assert parse(t)("Box(1@)") .matches t
  assert not(:(Box(Postfix(:@, 1))) .matches t)
end

test "Postfix percent remains punctuation; hash is a comment"
  def Percent type String%
  (p :: Percent) = "data"%
  expect p is "data"% :: Percent
  assert parse(Percent)(toString(Percent)(p)) == p
  x = 1# trailing comment
  y = 1 # separated comment
  assert x == y
  assert parse(Code)("x#") == parse(Code)("x")
  assert parse(Code)("x # comment") == parse(Code)("x")
end

test "Prefix and postfix operators must touch their operand"
  expect parse(Code)("T * *") fails "must touch their operand"
  expect parse(Code)("* *x") fails "must touch their operand"
  expect parse(Code)("T ? ?") fails "must touch their operand"
  expect parse(Code)("? ?x") fails "must touch their operand"
  expect parse(Code)("- (x)") fails "must touch their operand"
  expect parse(Code)("* (x)") fails "must touch their operand"
  parse(Code)("1 * *x")
  parse(Code)("1 * x*")
  parse(Code)("x* * 1")
  parse(Code)("1 ? ?x")
  parse(Code)("x? ? 1")
  parse(Code)("-(x)")
  parse(Code)("-x")
  parse(Code)("1 - (x)")
  assert parse(Code)("1 * *x") == parse(Code)("*(1)(*(x))")
  assert parse(Code)("1 * x*") == parse(Code)("*(1)(x*)")
  assert parse(Code)("x* * 1") == parse(Code)("*(x*)(1)")
  assert parse(Code)("T**") == parse(Code)("(T*)*")
end

test "Lifting remains a future source convention"
  (present :: Float?) = 4
  (absent :: Float?) = :None
  todo expect sqrt?(present) is 2 :: Float?
  todo expect sqrt?(absent) is None :: Float?
end
