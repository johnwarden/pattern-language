test "Raw runtime expressions can be interpreted as concrete values"
  legacy expect
    e = Rect(2, 2)
    e
  is Rect(2, 2) :: Expression

  todo expect
    e = Rect(2, 2)
    e
  fails "E_PATTERN_MISMATCH"

  def Rectangle type Rect(width :: Int, height :: Int)

  expect
    (r :: Rectangle) = Rect(2, 2)
    r
  is Rect(2, 2) :: Rectangle

  expect
    (r :: Rectangle) = Rect(2, 2)
    r.width
  is 2 :: Int

  expect
    (r :: Rectangle) = Rect(2, 2)
    r.height
  is 2 :: Int
end

test "Ordinary constructor bindings do not project a concrete value"
  def Rectangle type Rect(width :: Int, height :: Int)
  (r :: Rectangle) = Rect(2, 2)

  todo expect
    Rect(w, h) = r
    w
  fails "E_PATTERN_MISMATCH"
end

test "Explicit matching projects one concrete boundary with interpreted fields"
  def Rectangle type Rect(width :: Int, height :: Int)
  (r :: Rectangle) = Rect(2, 2)

  (w, h) =
    match r
      Rect(width, height) -> (width, height)
    end
  end

  expect w is 2 :: Int
  expect h is 2 :: Int
end
