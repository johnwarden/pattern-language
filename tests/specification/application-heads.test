# Decision on whether head is callable must happen during *evaluation* or *type checking*, not parsing.

test "Code preserves applications with non-callable heads"
  expect parse(Code)("True(1)") is True(1) :: Code
  expect parse(Code)("False(1)") is False(1) :: Code
  expect parse(Code)("1(1)") is 1(1) :: Code
  expect parse(Code)("\"x\"(1)") is "x"(1) :: Code
  expect parse(Code)("f(True(1))") is f(True(1)) :: Code
  expect parse(Code)("True(missing())") is True(missing()) :: Code
  expect parse(Code)("Bool(1)") is Bool(1) :: Code
  expect parse(Code)(":Tag(1)") is :Tag(1) :: Code
  expect parse(Code)("Tag(1)(2)") is Tag(1)(2) :: Code

  expect
    Code` True(1)
  is
    True(1) :: Code
  end
  expect Code(:(1(1))) is 1(1) :: Code
  assert :(True(1)) .matches Code
end

test "Evaluating a numeric or String head reports not callable"
  expect 1(1) fails "E_NOT_CALLABLE"
  expect "x"(1) fails "E_NOT_CALLABLE"
  expect (1 + 1)(1) fails "E_NOT_CALLABLE"

  def one() 1
  expect one()(1) fails "E_NOT_CALLABLE"
end

test "Evaluating ReservedSymbol heads reports not callable"
  expect Bool(1) fails "E_NOT_CALLABLE"
  expect Int(1) fails "E_NOT_CALLABLE"
  expect Any(1) fails "E_NOT_CALLABLE"
  expect Expression(1) fails "E_NOT_CALLABLE"

  head = Bool
  expect head(1) fails "E_NOT_CALLABLE"
  typeHead = Type
  expect typeHead(String) fails "E_NOT_CALLABLE"
  expect String([65]) is "A" :: String
end

test "Evaluating a Bool head must not reinterpret its payload as a Symbol"
  expect True(1) fails "E_NOT_CALLABLE"
  expect False(1) fails "E_NOT_CALLABLE"

  head = True
  expect head(1) fails "E_NOT_CALLABLE"

  def truth() 1 == 1
  expect truth()(1) fails "E_NOT_CALLABLE"
end

# The UpperCamelSymbol(...) form *looks* like a function call. 
# But Symbols are not callable functions.
test "A tag value is not implicitly a callable head"
  def Tagged type :Tag(NumericValue)
  expect Tag(1) :: Tagged is Tag(1) :: Tagged
  expect (:Tag)(1) :: Tagged fails "E_NOT_CALLABLE"
  expect :Tag(1) fails "E_NOT_CALLABLE"
  expect :(Tag(1)) is Tag(1) :: Expression

  head = :Tag :: UpperCamelSymbol
  expect head(2) fails "E_NOT_CALLABLE"

  head2 = :foo :: LowerCamelSymbol
  expect head2(2) fails "E_NOT_CALLABLE"
  head3 = :+ :: PunctuationSymbol
  expect head3(2) fails "E_NOT_CALLABLE"
end

test "A head expression may evaluate to a function"
  f = n -> n + 1
  expect f(2) is 3 :: NumericValue

  def make()
    n -> n
  end
  expect make()(7) is 7 :: NumericValue

  def add(x)(y) x + y
  expect add(2)(3) is 5 :: NumericValue
end

test "A constructed value is not implicitly a callable head"
  def Tagged type :Tag(NumericValue)
  value = Tag(1) :: Tagged
  expect value(2) fails "E_NOT_CALLABLE"

  def data() Tag(1) :: Tagged
  expect data()(2) fails "E_NOT_CALLABLE"
end

test "Any raw expression can go in head position"
  v = Tag(1)
  expect v(2) is Tag(1)(2) :: Expression
  expect Tag(1)(2) is Tag(1)(2) :: Expression

  expect 1 .Plus 2 is Plus(1)(2) :: Expression
end

