test "Argument-pack rest is valid in a Pair constructor"
  macro :all Pair(xs... :: Int*) Code$` $(xs)

  expect
    all Pair()
  is [] :: Expression
  expect
    all Pair(1)
  is [1] :: Expression
  expect
    all Pair(1, 2)
  is [1, 2] :: Expression
end

test "Argument-pack rest is valid in Args"
  macro :all Args(xs... :: Int*) Code$` $(xs)

  expect
    all Args()
  is [] :: Expression
  expect
    all Args(1)
  is [1] :: Expression
  expect
    all Args(1, 2)
  is [1, 2] :: Expression
end

test "A list annotation means a list in a constructor-shaped sidefix parameter"
  macro :show Args(x :: [_... :: Int*]) Code$` $(x)

  expect
    (show Args([1, 2]))
  is [1, 2] :: Expression
end

test "A list annotation means a list in a direct sidefix parameter"
  macro :show x :: [_... :: Int*] Code$` $(x)

  expect
    show [1, 2]
  is [1, 2] :: Expression
end

test "A list annotation does not accept adjacent operands as a list"
  expect
    macro :show x :: [_... :: Int*] Code` 0
    show 1 2
  fails "expected grammar"
end
