test "A named structural pattern works as an ascription"
  def Point type :Point(x :: Int)

  expect Point(1) :: Point is Point(1) :: Point
end

test "A named structural pattern works in a binding"
  def Point type :Point(x :: Int)
  (p :: Point) = Point(1)

  expect p is Point(1) :: Point
end

test "A named structural pattern works as a function parameter"
  def Point type :Point(x :: Int)
  def f(p :: Point) p

  expect f(Point(1)) is Point(1) :: Point
end

test "A named structural pattern works as a constructor-shaped macro parameter"
  def Point type :Point(x :: Int)
  macro :f Args(p :: Point) Code$` ($(p) :: Point)

  expect
    (f Args(Point(1)))
  is Point(1) :: Point
end

test "A named structural pattern works as a direct sidefix parameter"
  def Point type :Point(x :: Int)
  macro :f p :: Point q :: Point Code$` ($(p) :: Point)

  expect
    f Point(1) Point(2)
  is Point(1) :: Point
end

test "A named structural pattern works in a match arm"
  def Point type :Point(x :: Int)

  expect
    match Point(1)
      (p :: Point) -> p
    end
  is Point(1) :: Point
end

test "One positional and rest pattern agrees in a binding"
  Pair(first :: Int, rest... :: Int*) = (Pair(1, 2, 3) :: (type Pair(Int, Int, Int)))

  expect rest is [2, 3] :: (type [_... :: Int*])
end

test "One positional and rest pattern agrees in a function parameter"
  def f(Pair(first :: Int, rest... :: Int*)) rest

  expect f((Pair(1, 2, 3) :: (type Pair(Int, Int, Int)))) is [2, 3] :: (type [_... :: Int*])
end

test "One positional and rest pattern agrees in a match arm"
  expect
    match Pair(1, 2, 3) :: (type Pair(Int, Int, Int))
      Pair(first :: Int, rest... :: Int*) -> rest
    end
  is [2, 3] :: (type [_... :: Int*])
end

test "One positional and rest pattern agrees as a type accessor"
  def P type Pair(first :: Int, rest... :: Int*)
  p = Pair(1, 2, 3) :: P

  expect p.rest is [2, 3] :: (type [_... :: Int*])
end

test "One positional and rest pattern agrees in a macro parameter"
  macro :take Args(Pair(first :: Int, rest... :: Int*)) Code$` ([$(rest...)] :: (type [_... :: Rational*]))

  expect
    (take Args(Pair(1, 2, 3)))
  is [2, 3] :: (type [_... :: Rational*])
end

test "Whole quotation is inert and structural interpolation supplies values"
  x = 3

  expect :foo(x) fails "E_NOT_CALLABLE"
  expect :(foo(x)) is foo(:x) :: Expression
  expect
    Expression$` foo($x)
  is foo(3) :: Expression
end

test "Quoted root heads agree at runtime types"
  def Op type
    :|(Int)(Int)
  end

  assert :(1 | 2) .matches Op
end

test "Quoted root heads agree in a macro signature"
  def Op type
    :|(Int)(Int)
  end
  macro :take v :: Op Code` 1

  expect
    take 1 | 2
  is 1 :: Rational
end
