test "A quoted operator head matches as a function parameter"
  def split(:|(a)(b))
    (a, b)
  end
  (left, right) = split(:(X | Y))

  expect left is :X :: Expression
  expect right is :Y :: Expression
end

test "A quoted operator head matches in a binding"
  :|(a)(b) = :(X | Y)

  expect a is :X :: Expression
  expect b is :Y :: Expression
end

test "A quoted operator head matches in a match arm"
  (left, right) =
    match :(X | Y)
      :|(a)(b) -> (a, b)
    end
  end

  expect left is :X :: Expression
  expect right is :Y :: Expression
end

test "A quoted operator head matches a type"
  t =
    type
      :|(Symbol)(Symbol)
    end
  end
  x = :(X | Y)

  assert x .matches t
end

test "A quoted name is a literal match head"
  def Name type :name
  x = :name :: Name

  assert
    match x
      :name -> True
      _ -> False
    end
  end
end
