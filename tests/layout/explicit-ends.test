test "An indented function cannot terminate at EOF"
  source = "def f(x)\n  x"

  expect parse(Code)(source) error "E_BLOCK_END"
end

test "A nested block needs its own aligned end"
  source = '
    main = do
      f = do
        println("a")
      println("b")
      f
    end
  end

  expect parse(Code)(source) error "E_BLOCK_END"

  moved = '
    main = do
      f = do
        println("a")
        println("b")
      f
    end
  end

  expect parse(Code)(moved) error "E_BLOCK_END"
end

test "An expectation cannot borrow its enclosing test's end"
  source = '
    test "outer"
      expect
        def f(x: Int = (1 / 0)) x
        f(x: 8)
      result
        8 :: Int
    end
  end

  expect parse(Code)(source) error "E_BLOCK_END"
end

test "A final end can close a string and its surrounding if"
  source = '
    s = if True '
      Hello, World!
    else '
      What is cooking?
    end
    s
  end

  assert parse(Code)(source) .matches Code
end

test "An error clause closes an indented subject without a preceding end"
  expect
    missing()
  error "E_UNBOUND_NAME"
end

test "An indented last operand still needs an aligned end"
  assert
    True
  end
end

test "A completing inline clause does not invent a trailing end"
  expect
    if True
      1
    else 2
  result 1 :: Rational
end

test "Indentation around a completing clause does not change membership"
  expect
    missing()
  error "E_UNBOUND_NAME"
  expect missing() error "E_UNBOUND_NAME"
end

test "An indented operand without a later grammar clause needs end"
  source = "hold\n  True"

  expect parse(Code)(source) error "E_BLOCK_END"
end

test "Removing required infix spaces is an error"
  expect parse(Code)("a+b") error "infix operators require spaces"
  expect parse(Code)("x + ") error "infix operators require spaces"
end

test "An extra end after a complete inline clause is still accepted"
  expect
    if True
      1
    else 2
    end
  result 1 :: Rational
end

test "Quoted if/else branches share one end"
  expect
    if 1 == 1 '
      Hello
    else '
      there
    end
  result "Hello" :: Expression

  expect
    if 1 == 0 '
      Hello
    else '
      there
    end
  result "there" :: Expression

  source = "if 1 == 1 '\n    Hello\nelse '\n    there\nend"

  assert parse(Code)(source) .matches Code
end
