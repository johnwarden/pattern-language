test "An indented function cannot terminate at EOF"
  expect parse(Code)("def f(x)\n  x") fails "E_BLOCK_END"
end

test "A nested block needs its own aligned end"
  src = '
    main = x ->
      f = y ->
        y
      x
    end
    main
  end
  expect parse(Code)(src) fails "E_BLOCK_END"

  src = '
    main = x ->
      f = y ->
        y
        x
    end
    main
  end
  expect parse(Code)(src) fails "E_BLOCK_END"
end

test "An expectation cannot borrow its enclosing test's end"
  src = '
    test "outer"
      expect
        def f(x: Int = (1 / 0)) x
        f(x: 8)
      result
        8 :: Int
    end
  end
  expect parse(Code)(src) fails "E_BLOCK_END"
end

test "A final end can close a string and its surrounding if"
  source = '
    s = if True '
      Hello, World!
    else '
      What is cooking?
    end
    s
  end

  assert parse(Code)(source) .matches Code
end

test "An error clause closes an indented subject without a preceding end"
  expect
    missing()
  fails "E_UNBOUND_NAME"
end

test "An indented last operand still needs an aligned end"
  assert
    True
  end
end

test "A completing inline clause does not invent a trailing end"
  expect
    if True
      1
    else 2
  is 1 :: NumericValue
end

test "Indentation around a completing clause does not change membership"
  expect
    missing()
  fails "E_UNBOUND_NAME"
  expect missing() fails "E_UNBOUND_NAME"
end

test "An indented operand without a later grammar clause needs end"
  expect parse(Code)("hold\n  True") fails "E_BLOCK_END"
end

test "Removing required infix spaces is an error"
  expect parse(Code)("a+b") fails "infix operators require spaces"
end

test "infix"
  expect parse(Code)("x + ") fails "Missing second argument to infix operation"
end

test "An extra end after a complete inline clause is an error"
  expect parse(Code)("if True\n  1\nelse 2\nend") fails "E_UNEXPECTED_END"
end

test "An extra end does not steal an enclosing block"
  src = '
    f = x ->
      if True
        1
      else 2
      end
      x
    end
  end
  expect parse(Code)(src) fails "E_UNEXPECTED_END"
end

test "Quoted if/else branches share one end"
  expect
    if 1 == 1 '
      Hello
    else '
      there
    end
  is "Hello" :: String

  expect
    if 1 == 0 '
      Hello
    else '
      there
    end
  is "there" :: String

  source = "if 1 == 1 '\n    Hello\nelse '\n    there\nend"

  assert parse(Code)(source) .matches Code
end
