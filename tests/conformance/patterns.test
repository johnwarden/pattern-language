test "independent captures"
  Pair(x, y) = Pair(1, 2)
  (observed1, observed2) =
    (x, y)
  end
  legacy expect observed1 result 1 :: Expression
  legacy expect observed2 result 2 :: Expression
  # Inspect the captured return values.
  (observed1, observed2)
end

test "list rest empty"
  def copy(xs...) [xs...]
  legacy expect copy() result [] :: Expression
end

test "list rest singleton"
  def copy(xs...) [xs...]
  legacy expect copy(1) result [1] :: Expression
end

test "single pattern grouping"
  (x) = 1
  legacy expect x result 1 :: Expression
end
