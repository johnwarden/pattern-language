test "arithmetic"
  a = 1 :: Int
  b = 2 :: Int

  expect a + b result 3 :: Int
end

test "dot is function call"
  def b(x) y -> x + y
  a = 1 :: Int

  expect a .b 2 :: Int result 3 :: Int
end

test "empty call"
  def f() 42

  expect f() result 42 :: Rational
end

test "explicit named function parameter"
  def f(x, foo: y) y

  expect f(1, foo: 2) result 2 :: Rational
end

test "multiple packs"
  def f(x :: Int, y :: Int)(z :: Int)
    (x + y) * z
  end
  g = f(1, 2)

  expect g(3) result 9 :: Int
end

test "no eager execution"
  def f()
    (1 / 0)
  end

  expect 7 result 7 :: Rational
end

test "parameter interpretation"
  def Rectangle type :Rect(w :: Float, h :: Float)
  def area(r :: Rectangle) r.w * r.h

  expect area(Rect(3, 4)) result 12 :: Float
end

test "same precedence"
  a = 2 :: Int
  b = 3 :: Int
  c = 4 :: Int

  expect a * b + c result 14 :: Int
end

test "single grouping"
  x = (1)

  expect x result 1 :: Rational
end
