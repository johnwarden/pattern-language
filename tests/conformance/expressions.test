test "dot is function call"
  def b(x) y -> x + y
  a = 1 :: Int

  expect a .b 2 :: Int is 3 :: Int
end

test "empty call"
  def f() 42

  expect f() is 42 :: NumericValue
end

test "explicit named function parameter"
  def f(x, foo: y) y

  expect f(1, foo: 2) is 2 :: NumericValue
end

test "multiple packs"
  def f(x :: Int, y :: Int)(z :: Int)
    (x + y) * z
  end
  g = f(1, 2)

  expect g(3) is 9 :: Int
end

test "no eager execution"
  def f()
    (1 / 0)
  end

  expect 7 is 7 :: NumericValue
end

test "parameter interpretation"
  def Rectangle type :Rect(w :: Float, h :: Float)
  def area(r :: Rectangle) r.w * r.h

  expect area(Rect(3, 4)) is 12 :: Float
end

test "same precedence"
  a = 2 :: Int
  b = 3 :: Int
  c = 4 :: Int

  expect a * (b + c) is 14 :: Int
end

test "single grouping"
  x = (1)

  expect x is 1 :: NumericValue
end
