test "Canonical text chooses short exact decimal spellings"
  expect toString(Rational)(2 / 4) is "0.5" :: String
  expect toString(Rational)(3 / 1) is "3" :: String
  expect toString(Rational)(0 / 5) is "0" :: String
  todo expect toString(Rational)(1000) is "1e3" :: String
  todo expect toString(Rational)(0.001) is "1e-3" :: String
  todo expect toString(Rational)(1 / 10000000000000000) is "1e-16" :: String
  todo expect toString(Rational)(1 / 100000000000000000) is "1e-17" :: String
end

test "Canonical text compares exact hexadecimal and binary spellings"
  todo expect toString(Rational)(1 / 16) is "0x0.1" :: String
  expect toString(Rational)(1 / 1048576) is "0x1p-20" :: String
  todo expect toString(Rational)(18446744073709551615) is "0xFFFFFFFFFFFFFFFF" :: String
  todo expect toString(Rational)(0b1p-2000) is "0x1p-2000" :: String
  todo assert parse(Rational)(toString(Rational)(0x1p-2000)) == 0x1p-2000
end

test "A Float64-selected spelling is canonical only for its exact value"
  todo expect toString(Rational)(0f0.1) is "0f0.1" :: String
  todo expect toString(Rational)(3602879701896397 / 36028797018963968) is "0f0.1" :: String
  expect toString(Rational)(0.1) is "0.1" :: String
  assert toString(Rational)(0f0.1) != toString(Rational)(0.1)
  assert parse(Rational)(toString(Rational)(0f0.1)) == 0f0.1
end

test "Canonical text breaks ties by family and then by omitting the exponent"
  # The preferred form also wins when the input uses another equal-length spelling.
  expect toString(Rational)(0x0.2) is "0.125" :: String
  expect toString(Rational)(1 / 8) is "0.125" :: String
  expect toString(Rational)(1e2) is "100" :: String
  expect toString(Rational)(1e-2) is "0.01" :: String
end

test "Reduced fraction text competes with decimal exponents and keeps its sign"
  negative = -2 / 6
  scaled = 100000000000000000000 / 3

  todo expect toString(Rational)(negative) is "(-1/3)" :: String
  todo expect toString(Rational)(1 / 300) is "(1/300)" :: String
  todo expect toString(Rational)(scaled) is "(1/3)e20" :: String
  todo expect toString(Rational)(-scaled) is "(-1/3)e20" :: String
  todo assert parse(Rational)(toString(Rational)(negative)) == negative
  todo assert parse(Rational)(toString(Rational)(scaled)) == scaled
  todo assert toString(Rational)(parse(Rational)("(1/3)e20")) == toString(Rational)(scaled)
end
