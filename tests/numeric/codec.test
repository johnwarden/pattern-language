test "exact literals, large hex, 1/3 serialization, and Code quote equality"
  assert (0.1 != 0f0.1)
  assert (0.5 == 0f0.5)
  assert (0x20000000000001 != 0x20000000000000)
  assert (syntaxExpression(syntaxTree(0.5)) == 0.5)
  assert (syntaxExpression(syntaxTree(0f0.1)) == 0f0.1)
  assert ((Code$` $(0.1)) == (Code` 0.1))
  expect 0.1 result 0.1 :: Rational
  expect 0f0.1 result 0x1.999999999999Ap-4 :: Rational
  expect
    1 / 3
  error "E_VALUE_SERIALIZATION"
  end
end

test "numeric SyntaxNode codec must not silently collapse distinct Rationals"
  todo assert ((syntaxTree(0.1) == syntaxTree(0f0.1)) == False)
  todo assert (syntaxExpression(syntaxTree(0.1)) == 0.1)
