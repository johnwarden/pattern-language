
test "BUG: bare function name in where clause"
	def isSquare(r :: Rectangle) r.width == r.height
	def Rectangle type Rect(width :: Int, height :: Int)

	test "this works"
		def Square type Rectangle .where r -> isSquare(r)
		(s :: Square) = Rect(2, 2)
	end

	todo test "But this produces an error"
		def Square type Rectangle .where r -> isSquare(r)
		(s :: Square) = Rect(2, 2)
	end
end


