test "A type accessor name does not occupy the variable namespace"
  def R type :R(x :: Int)
  x = 5

  expect x is 5 :: NumericValue
end

test "A defined function uses its own parameter names"
  def R type :R(x :: Int)
  def inc(x) x + 1

  expect inc(2) is 3 :: NumericValue
end

test "A variable and a defined function can share a name"
  def f(x) x + 1
  f = 9
  (value, applied) = (f, f(2))

  expect value is 9 :: NumericValue
  expect applied is 3 :: NumericValue
end

test "A callable variable is invoked by a call"
  f = x -> x + 1

  expect f(2) is 3 :: NumericValue
end

test "Defined functions can be overloaded on disjoint constructors"
  def f(:Red) 1
  def f(:Blue) 2
  (red, blue) = (f(:Red), f(:Blue))

  expect red is 1 :: NumericValue
  expect blue is 2 :: NumericValue
end

test "An overlapping defined function is ambiguous"
  expect
    def f(x) 1
    def f(:Red) 2
    f(:Red)
  fails "ambiguous call"
end

test "Variables, functions and accessors keep separate uses of the same name"
  def R type :R(x :: Int)
  x = 5
  r = R(2) :: R
  (bound, accessed, dotted) = (x, x(r), r.x)

  expect bound is 5 :: NumericValue
  expect accessed is 2 :: Int
  expect dotted is 2 :: Int
end

test "Defined functions are not values"
  expect
    def f(x) x
    f
  fails "cannot be used as a value"
end

test "Defined functions cannot be passed as values"
  expect
    def f(x) x
    def use(x) x
    use(f)
  fails "cannot be used as a value"
end

test "Defined functions cannot be returned as values"
  expect
    def f(x) x
    def make() f
    make()
  fails "cannot be used as a value"
end

test "Accessors are not values"
  expect
    def Rectangle type :Rect(w :: Float, h :: Float)
    w
  fails "cannot be used as a value"
end

test "toString is not a value"
  expect toString fails "cannot be used as a value"
end

test "A callable variable can be passed after being bound"
  def Rectangle type :Rect(w :: Float, h :: Float)
  r = Rect(3, 4) :: Rectangle
  w = (r :: Rectangle) -> r.h
  local = w

  expect local(r) is 4 :: Float
end

test "A callable variable competes with an accessor"
  expect
    def Rectangle type :Rect(w :: Float, h :: Float)
    r = Rect(3, 4) :: Rectangle
    w = (r :: Rectangle) -> r.h
    w(r)
  fails "ambiguous call"
end

test "A dotted accessor competes with a callable variable"
  expect
    def Rectangle type :Rect(w :: Float, h :: Float)
    r = Rect(3, 4) :: Rectangle
    w = (r :: Rectangle) -> r.h
    r.w
  fails "ambiguous call"
end

test "Direct calls select the only matching callable across namespaces"
  def f(x :: Float) x + (1 :: Float)
  f = (x :: String) -> x
  (n, s) = (f(2), f("hi"))

  expect n is 3 :: Float
  expect s is "hi" :: String
end

test "A non-callable variable does not hide a defined function"
  def f(x) x + 1
  f = 99
  (value, applied) = (f, f(2))

  expect value is 99 :: NumericValue
  expect applied is 3 :: NumericValue
end

test "A callable variable is ambiguous with a defined function of the same domain"
  expect
    def f(x) x
    f = x -> x + 1
    f(2)
  fails "ambiguous"
end

test "Actions are absent"
  expect action(() -> ()) fails "unbound name"
end

test "Prefix exclamation stays reserved"
  expect
    !(1)
  fails "reserved"
end

test "Ambiguous patterns do not silently fall through match arms"
  expect
    match 1
      (x | x) -> 10
      _ -> 20
    end
  fails "E_AMBIGUOUS_VALUE_DESIGNATOR"
end

test "Ambiguous patterns do not silently dispatch"
  expect
    def f(x | x) 1
    f(1)
  fails "E_AMBIGUOUS_VALUE_DESIGNATOR"
end

test "Infix needs spaces"
  expect parse(Code)("1+2") fails "spaces"
end

test "Named precedes positional"
  expect parse(Code)("Rect(w: 1, 2)") fails "positional"
end

test "Duplicate labels"
  expect parse(Code)("Rect(w: 1, w: 2)") fails "duplicate"
end
