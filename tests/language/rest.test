test "Rest captures only remaining positional fields from one argument"
  def f(first, rest... :: Rational*) [rest...] :: Rational*

  expect f(1) is [] :: Rational*
end

test "Rest captures only remaining positional fields from two arguments"
  def f(first, rest... :: Rational*) [rest...] :: Rational*

  expect f(1, 2) is [2] :: Rational*
end

test "Rest captures only remaining positional fields from three arguments"
  def f(first, rest... :: Rational*) [rest...] :: Rational*

  expect f(1, 2, 3) is [2, 3] :: Rational*
end

test "Rest captures ignore extra names"
  def f(first, rest... :: Rational*) [rest...] :: Rational*

  expect f(1, foo: 2) is [] :: Rational*
end

test "Rest captures remaining positional fields in a binding"
  (first, rest... :: Rational*) = (1, 2, 3)

  expect [rest...] :: Rational* is [2, 3] :: Rational*
end

test "Rest captures remaining positional fields from one value"
  (first, rest... :: Rational*) = (1)

  expect [rest...] :: Rational* is [] :: Rational*
end

test "Rest captures remaining positional fields from two values"
  (first, rest... :: Rational*) = (1, 2)

  expect [rest...] :: Rational* is [2] :: Rational*
end

test "Rest captures ignore extra names in a binding"
  (first, rest... :: Rational*) = (1, foo: 2)

  expect [rest...] :: Rational* is [] :: Rational*
end

test "List rest captures remaining elements"
  [first, rest... :: Rational*] = [1, 2, 3] :: Rational*

  expect [rest...] :: Rational* is [2, 3] :: Rational*
end

test "Rest captures are empty list values at the empty tail"
  [y, rest... :: Rational*] = [1] :: Rational*

  expect rest is [] :: Rational*
end

test "Rest captures are list values at a singleton tail"
  [y, rest... :: Rational*] = [1, 2] :: Rational*

  expect rest is [2] :: Rational*
end

test "Rest captures are list values at a longer tail"
  [y, rest... :: Rational*] = [1, 2, 3] :: Rational*

  expect rest is [2, 3] :: Rational*
end

test "Rest captures are empty list values in a pack binding"
  (y, rest... :: Rational*) = (1)

  expect rest is [] :: Rational*
end

test "Rest captures are list values in a pack binding"
  (y, rest... :: Rational*) = (1, 2)

  expect rest is [2] :: Rational*
end

test "Rest captures are longer list values in a pack binding"
  (y, rest... :: Rational*) = (1, 2, 3)

  expect rest is [2, 3] :: Rational*
end

test "Rest captures are empty list values in a function"
  def f(y, rest... :: Rational*) rest

  expect f(1) is [] :: Rational*
end

test "Rest captures are singleton list values in a function"
  def f(y, rest... :: Rational*) rest

  expect f(1, 2) is [2] :: Rational*
end

test "Rest captures are list values in a function"
  def f(y, rest... :: Rational*) rest

  expect f(1, 2, 3) is [2, 3] :: Rational*
end

test "Rest captures are empty list values in a type accessor"
  def V type [y :: Int, rest... :: Int*]
  v = [1] :: V

  expect v.rest is [] :: Int*
end

test "Rest captures are singleton list values in a type accessor"
  def V type [y :: Int, rest... :: Int*]
  v = [1, 2] :: V

  expect v.rest is [2] :: Int*
end

test "Rest captures are list values in a type accessor"
  def V type [y :: Int, rest... :: Int*]
  v = [1, 2, 3] :: V

  expect v.rest is [2, 3] :: Int*
end

test "Empty rest list values compare equal"
  [y, rest... :: Rational*] = [1] :: Rational*

  assert rest == ([] :: Rational*)
end

test "Singleton rest list values compare equal"
  [y, rest... :: Rational*] = [1, 2] :: Rational*

  assert rest == ([2] :: Rational*)
end

test "Rest list values compare equal at every length"
  [y, rest... :: Rational*] = [1, 2, 3] :: Rational*

  assert rest == ([2, 3] :: Rational*)
end

test "Rest list values can be spread"
  [y, rest... :: Rational*] = [1, 2] :: Rational*

  expect [0, rest...] :: Rational* is [0, 2] :: Rational*
end

test "Rest list values match a list parameter"
  def one(x :: [_... :: Int*]) x
  [y, rest... :: Int*] = [1, 2] :: Int*

  expect one(rest) is [2] :: Int*
end
