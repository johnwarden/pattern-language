test "Whole-expression quotation is inert; typed interpolation supplies values"
  x = 3
  whole = :(Box(x))
  expanded = Expression$` Box($x)

  expect :Box(x) fails "E_NOT_CALLABLE"
  expect expanded is Box(3) :: Expression
  expect whole is Box(:x) :: Expression
  (whole, expanded)
end

test "Matching a quoted binding does not evaluate it"
  code = Code` f = x -> x * 2

  expect
    match code
      :(_ = _) -> True
      _ -> False
    end
  is True :: Bool
  expect f fails "E_UNBOUND_NAME"
end

test "Typed quote blocks expand macro templates with explicit interpolation"
  macro :addOne Args(x)
    Code$`
      y = $x
      y + 1
    end
  end

  expect
    (addOne Args(4))
  is 5 :: NumericValue
end

test "Reader blocks preserve raw punctuation and indented end content"
  def inspect(fragments, values) fragments

  expect
    inspect'
      " ' \ $x
        end
      tail
    end # close
  is ["\" ' \\ $x\n  end\ntail"] :: Expression
end

test "Interpolating a postfix percent preserves its spelling"
  expect
    $"$("x"%)"
  is '"x"%' :: String
end
