test "Captured matrix rows spread vertically without flattening"
  type Matrix concrete [
    cells... :: Float32**
    ...
  ]
  original = ([
    ()
    (0.5,)
    1, 2
  ] :: Matrix)
  rows = original.cells
  rebuilt = ([
    rows...
    ...
  ] :: Matrix)

  assert rebuilt == original
  expect
    rebuilt
  result
    [
      ()
      (0.5,)
      1, 2
    ] :: Matrix
  end
end

test "Vertical spreading distinguishes an empty matrix from one empty row"
  type Matrix concrete [
    cells... :: Float32**
    ...
  ]
  empty = ([
  ] :: Matrix)
  oneRow = ([
    ()
  ] :: Matrix)
  emptyCopy = ([
    empty.cells...
    ...
  ] :: Matrix)
  rowCopy = ([
    oneRow.cells...
    ...
  ] :: Matrix)

  assert emptyCopy == empty
  assert rowCopy == oneRow
  assert emptyCopy != rowCopy
  expect
    emptyCopy
  result
    [
    ] :: Matrix
  end
  expect
    rowCopy
  result
    [
      ()
    ] :: Matrix
  end
end

test "Vertical spreading retains surrounding rows in source order"
  type Matrix concrete [
    cells... :: Float32**
    ...
  ]
  middle = ([
    1, 2
    4
  ] :: Matrix)
  combined = ([
    0.5
    middle.cells...
    ...
    8, 16
  ] :: Matrix)

  expect
    combined
  result
    [
      0.5
      1, 2
      4
      8, 16
    ] :: Matrix
  end
end

test "Vertical spreading retains interpreted Float32 elements"
  type Matrix concrete [
    cells... :: Float32**
    ...
  ]
  original = ([
    float32(0.1), 1
  ] :: Matrix)
  rebuilt = ([
    original.cells...
    ...
  ] :: Matrix)

  assert rebuilt == original
  assert rebuilt.cells == original.cells
end

test "Brace collection rows spread with the same dimensions"
  type Table concrete {
    cells... :: String**
    ...
  }
  original = ({
    "first"
    ()
    "second", "third"
  } :: Table)
  rebuilt = ({
    original.cells...
    ...
  } :: Table)

  assert rebuilt == original
  expect
    rebuilt
  result
    {
      "first"
      ()
      "second", "third"
    } :: Table
  end
end

test "Vertical spreading requires a list of row lists"
  expect
    rows = 1
    [
      rows...
      ...
    ]
  error "E_VERTICAL_SPREAD"

  expect
    rows = [1, 2]
    [
      rows...
      ...
    ]
  error "E_VERTICAL_SPREAD"
end

test "A vertical value marker requires a preceding row"
  expect
    [
      ...
    ]
  error "E_VERTICAL_SPREAD"
end

test "Quoted vertical row spreads remain inert Code"
  quoted = Code` [
    missingRows()...
    ...
  ]

  assert parse(Code)(toString(Code)(quoted)) == quoted
end
