test "Explicit factories supply defaults and complete typed values"
  def Rectangle type Rect(w :: Int, h :: Int, color: String)
  def rectangle(w :: Int, h :: Int, color: String = "black") Rect(w, h, color: color) :: Rectangle
  expect rectangle(2, 3) result Rect(2, 3, color: "black") :: Rectangle
  expect rectangle(2, 3, color: "white") result Rect(2, 3, color: "white") :: Rectangle
  expect rectangle(2, 3).color result "black" :: String
  assert
    (rectangle(2, 3) == (Rect(2, 3, color: "black") :: Rectangle))
end

test "Declarations cannot rewrite symbolic construction"
  def Plain type Rect(Int, Int)
  def Rectangle type Rect(w :: Int, h :: Int, color: String)
  (observed1, observed2) =
    (Rect(2, 3), Rectangle(2, 3))
  end
  legacy expect observed1 result Rect(2, 3) :: Expression
  legacy expect observed2 result Rectangle(2, 3) :: Expression
  (observed3, observed4) =
    (Rect(2, 3) .matches (type Plain), Rect(2, 3) .matches (type Rectangle))
  end
  assert
    observed3
  assert
    (
      observed4
    ) == False
end

test "Destructuring defaults bind captures without adding fields"
  raw = Rect(2, 3)
  Rect(w, h, color: c :: String = "black") = raw
  (observed1, observed2) =
    (raw, c)
  end
  legacy expect observed1 result Rect(2, 3) :: Expression
  legacy expect observed2 result "black" :: String
  (size: Int, color: String = "black") = (size: 3)
  (observed3, observed4) =
    (size, color)
  end
  expect observed3 result 3 :: Int
  expect observed4 result "black" :: String
end

test "Named and anonymous parameter defaults share binding semantics"
  def f(R(color: String = "black")) color
  raw = R()
  (observed1, observed2) =
    (f(raw), raw)
  end
  legacy expect observed1 result "black" :: String
  legacy expect observed2 result R() :: Expression
  g = (color: c :: String = "black") -> c
  expect g() result "black" :: String
end

test "Match defaults preserve the scrutinee"
  raw = R()
  color =
    match raw
      R(color: c :: String = "black") -> c
    end
  end
  (observed1, observed2) =
    (raw, color)
  end
  legacy expect observed1 result R() :: Expression
  legacy expect observed2 result "black" :: String
  # Inspect the captured return values.
  (observed1, observed2)
end

test "Supplied values are validated and never replaced by defaults"
  expect
    def f(x: Int = (1 / 0)) x
    f(x: 8)
  result
    8 :: Int
  expect
    def f(x: Int = 3) x
    f(x: "bad")
  error "no applicable function"
  expect
    def f(x: Int = "bad") x
    f()
  error "default for x"
end

test "Supplied fields select an overload before binding defaults"
  def f(x: Int = (1 / 0)) x
  def f(x: String = "fallback") x
  expect f(x: "hello") result "hello" :: String
  expect f(x: 4) result 4 :: Int
  expect
    f()
  error "ambiguous call"
end

test "Defaults retain lexical bindings and successive packs"
  n = 3
  def f(x: Int = n)(y :: Int) x + y
  g = f()
  expect g(4) result 7 :: Int
end

test "Binding defaults preserve option semantics"
  def Color type :Black | :White
  expect
    def f(color: Color? = Some(:Black)) color
    f()
  result
    Some(:Black) :: ?(Color)
  expect
    def f(color: Color? = :Black) color
    f()
  error "default for color"
end
