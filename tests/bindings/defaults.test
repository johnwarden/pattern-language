test "Explicit factories supply defaults and complete typed values"
  def Rectangle type Rect(w :: Int, h :: Int, color: String)
  def rectangle(w :: Int, h :: Int, color: String = "black") Rect(w, h, color: color) :: Rectangle

  expect rectangle(2, 3) is Rect(2, 3, color: "black") :: Rectangle
  expect rectangle(2, 3, color: "white") is Rect(2, 3, color: "white") :: Rectangle
  expect rectangle(2, 3).color is "black" :: String

  assert rectangle(2, 3) == (Rect(2, 3, color: "black") :: Rectangle)
end

test "A declaration does not make a matching constructor head a factory"
  def Plain type Rect(Int, Int)
  def Rectangle type Rect(w :: Int, h :: Int, color: String)
  r = Rect(2, 3) :: Plain

  expect r is Rect(2, 3) :: Plain
  assert not(r .matches Rectangle)

  legacy expect Rectangle(2, 3) is Rectangle(2, 3) :: Expression
  todo expect Rectangle(2, 3) fails "concrete type"
end

test "Destructuring defaults bind captures without adding fields"
  def Plain type Rect(Int, Int)
  rect = Rect(2, 3) :: Plain
  Rect(w, h, color: c :: String = "black") = rect

  expect rect is Rect(2, 3) :: Plain
  expect c is "black" :: String

  (size: Int, color: String = "black") = (size: 3)

  expect size is 3 :: Int
  expect color is "black" :: String

  def Color type :Red | :Green
  (x, color: c :: Color = :Red) = (1)

  assert x == 1
  expect c is Red :: Color
end

test "Named and anonymous parameter defaults share binding semantics"
  def Plain type R()
  def f(R(color: String = "black")) color
  r = R() :: Plain

  expect f(r) is "black" :: String
  expect r is R() :: Plain

  g = (color: c :: String = "black") -> c

  expect g() is "black" :: String
end

test "Match defaults preserve the scrutinee"
  def Plain type R()
  raw = R() :: Plain
  color =
    match raw
      R(color: c :: String = "black") -> c
    end
  end

  expect raw is R() :: Plain
  expect color is "black" :: String
end

test "Supplied values are validated and never replaced by defaults"
  expect
    def f(x: Int = (1 / 0)) x
    f(x: 8)
  is 8 :: Int

  expect
    def f(x: Int = 3) x
    f(x: "bad")
  fails "no applicable function"

  expect
    def f(x: Int = "bad") x
    f()
  fails "default for x"
end

test "Supplied fields select an overload before binding defaults"
  def f(x: Int = (1 / 0)) x
  def f(x: String = "fallback") x

  expect f(x: "hello") is "hello" :: String
  expect f(x: 4) is 4 :: Int
  expect
    f()
  fails "ambiguous call"
end

test "Defaults retain lexical bindings and successive packs"
  n = 3
  def f(x: Int = n)(y :: Int) x + y
  g = f()

  expect g(4) is 7 :: Int
end

test "Binding defaults preserve option semantics"
  def Color type :Black | :White
  def f(color: Color? = :Black) color
  def g(color: Color? = Some(:Black)) color

  expect f() is Black :: Color?
  expect
    g()
  fails "default for color"
end
