test "Unwrapped nested option designates a unique String"
  type Inner concrete String | :None
  type Nested concrete Inner | :None
  (outer :: Nested) = "Hello"

  expect outer is "Hello" :: Nested
  assert "Hello" .matches Nested
  assert (type Nested) != (type Inner)
end

test "Bare nested absence selects the direct outer arm"
  type Inner concrete String | :None
  type Nested concrete Inner | :None
  (outer :: Nested) = :None
  (inner :: Nested) = :None :: Inner

  expect outer is None :: Nested
  expect inner is (None :: Inner) :: Nested
  assert outer != inner
end

test "Match projects one unwrapped option boundary"
  type Inner concrete String | :None
  type Nested concrete Inner | :None
  (outer :: Nested) = "Hello"

  expect
    match outer
      (inner :: Inner) -> inner
    end
  is "Hello" :: Inner

  expect
    match outer
      (inner :: Inner) -> match inner
        (s :: String) -> s
      end
    end
  is "Hello" :: String
end

test "Ordinary binding and dispatch do not unwrap Nested"
  type Inner concrete String | :None
  type Nested concrete Inner | :None
  (outer :: Nested) = "Hello"

  expect
    (inner :: Inner) = outer
    inner
  fails "E_PATTERN_MISMATCH"

  expect
    def take(x :: Inner) x
    take(outer)
  fails "E_NO_METHOD"
end

test "Match-arm defaults do not inherit projection"
  type Inner concrete String | :None
  type Nested concrete Inner | :None
  (outer :: Nested) = "Hello"
  def take(x :: Inner) True

  expect take(outer) fails "E_NO_METHOD"
  expect
    match :Unit
      (_, missing: v = take(outer)) -> v
    end
  fails "E_PATTERN_MISMATCH"
end

test "Match-arm predicates do not inherit projection"
  type Inner concrete String | :None
  type Nested concrete Inner | :None
  (outer :: Nested) = "Hello"
  def take(x :: Inner) True
  def Refined Nested .where (x -> take(outer))

  expect take(outer) fails "E_NO_METHOD"
  expect
    match outer
      (v :: Refined) -> v
    end
  fails "E_PATTERN_MISMATCH"
end

test "Match does not skip two unwrapped option boundaries"
  type Inner concrete String | :None
  type Nested concrete Inner | :None
  (outer :: Nested) = "Hello"

  expect
    match outer
      (s :: String) -> s
    end
  fails "E_PATTERN_MISMATCH"
end

test "The source optional convention is unwrapped T | :None"
  expect
    (present :: String?) = "Hello"
    present
  is "Hello" :: String?

  expect
    (absent :: String?) = :None
    absent
  is None :: String?

  expect
    (tagged :: String?) = Some("Hello")
    tagged
  fails "E_PATTERN_MISMATCH"
end

test "Nested postfix String?? designates a unique String"
  expect
    (outer :: String??) = "Hello"
    outer
  is "Hello" :: String??

  assert "Hello" .matches (type String??)
  assert (type String??) != (type String?)
end

test "Nested postfix absence preserves explicit member evidence"
  (outer :: String??) = :None
  (inner :: String??) = :None :: String?
  (same :: String??) = :None :: String??

  expect outer is None :: String??
  expect inner is (None :: String?) :: String??
  expect same is None :: String??
  assert outer == same
  assert outer != inner
end

test "Match projects one postfix option boundary"
  (outer :: String??) = "Hello"

  expect
    match outer
      (inner :: String?) -> inner
    end
  is "Hello" :: String?

  expect
    match outer
      (inner :: String?) -> match inner
        (s :: String) -> s
      end
    end
  is "Hello" :: String
end

test "Ordinary binding and dispatch do not unwrap String??"
  (outer :: String??) = "Hello"

  expect
    (inner :: String?) = outer
    inner
  fails "E_PATTERN_MISMATCH"

  expect
    def take(x :: String?) x
    take(outer)
  fails "E_NO_METHOD"
end

test "Match-arm defaults do not inherit postfix option projection"
  (outer :: String??) = "Hello"
  def take(x :: String?) True

  expect take(outer) fails "E_NO_METHOD"
  expect
    match :Unit
      (_, missing: v = take(outer)) -> v
    end
  fails "E_PATTERN_MISMATCH"
end

test "Match-arm predicates do not inherit postfix option projection"
  (outer :: String??) = "Hello"
  def take(x :: String?) True
  def Refined String?? .where (x -> take(outer))

  expect take(outer) fails "E_NO_METHOD"
  expect
    match outer
      (v :: Refined) -> v
    end
  fails "E_PATTERN_MISMATCH"
end

test "Match does not skip two postfix option boundaries"
  (outer :: String??) = "Hello"

  expect
    match outer
      (s :: String) -> s
    end
  fails "E_PATTERN_MISMATCH"
end
