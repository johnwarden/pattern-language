# Acceptance input for specs/approved/expect-predicates.md.
# Host checks consume this file; supported passing cases belong in tests/.

todo test "Equality expectation uses is"
  expect 1 is 1 :: Rational
end

todo test "Failure expectation uses fails"
  expect 1(1) fails "E_NOT_CALLABLE"
end

# String-only substring checks and their expected failures are drafted separately
# in expect-contains.test, with the authored outcomes in expect-contains.md.
