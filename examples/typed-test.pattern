# Test is inert data. The external test harness executes its Code body.
def ExpectedOutput type
  (e :: Expression) ::: (type :: Expression)
end
def Test type :test name :: String code :: Code :expect expected :: ExpectedOutput

t = Test`
  test "Typed code body"
    x = 3
    x + 1
  end
  expect
    4 :: Int
  end
end

(t.name,t.expected.e,t.expected.type)
