def Test type :test name :: String body :: Expression
def TodoTest type :todo :test name :: String body :: Expression
def TestBlock unionType Test | TodoTest
def TestFileContent type
  first :: TestBlock
  rest :: TestBlock*
  ...
end
def tests(f :: TestFileContent) [f.first,f.rest...]
def testParts(t :: Test)
  ("check", t.name, t.body)
end
def testParts(t :: TodoTest)
  ("todo", t.name, t.body)
end
def IsExpectation type :expect subject :: Expression :is expected :: Expression
def stepParts(e :: IsExpectation)
  ("is", "check", e.subject, e.expected)
end
def FailsExpectation type :expect subject :: Expression :fails reason :: String
def stepParts(e :: FailsExpectation)
  ("fails", "check", e.subject, e.reason)
end
def ContainsExpectation type :expect subject :: Expression :contains needle :: Expression
def stepParts(e :: ContainsExpectation)
  ("contains", "check", e.subject, e.needle)
end
def Assertion type :assert condition :: Expression
def stepParts(e :: Assertion)
  ("assert", "check", e.condition)
end
def LegacyIsExpectation type :legacy :expect subject :: Expression :is expected :: Expression
def stepParts(e :: LegacyIsExpectation)
  ("is", "legacy", e.subject, e.expected)
end
def LegacyFailsExpectation type :legacy :expect subject :: Expression :fails reason :: String
def stepParts(e :: LegacyFailsExpectation)
  ("fails", "legacy", e.subject, e.reason)
end
def LegacyContainsExpectation type :legacy :expect subject :: Expression :contains needle :: Expression
def stepParts(e :: LegacyContainsExpectation)
  ("contains", "legacy", e.subject, e.needle)
end
def LegacyAssertion type :legacy :assert condition :: Expression
def stepParts(e :: LegacyAssertion)
  ("assert", "legacy", e.condition)
end
def TodoIsExpectation type :todo :expect subject :: Expression :is expected :: Expression
def stepParts(e :: TodoIsExpectation)
  ("is", "todo", e.subject, e.expected)
end
def TodoFailsExpectation type :todo :expect subject :: Expression :fails reason :: String
def stepParts(e :: TodoFailsExpectation)
  ("fails", "todo", e.subject, e.reason)
end
def TodoContainsExpectation type :todo :expect subject :: Expression :contains needle :: Expression
def stepParts(e :: TodoContainsExpectation)
  ("contains", "todo", e.subject, e.needle)
end
def TodoAssertion type :todo :assert condition :: Expression
def stepParts(e :: TodoAssertion)
  ("assert", "todo", e.condition)
end
def LegacySetup type :legacy statement :: Expression
def stepParts(e :: LegacySetup)
  ("setup", "legacy", e.statement)
end
def TodoSetup type :todo statement :: Expression
def stepParts(e :: TodoSetup)
  ("setup", "todo", e.statement)
end
TestFileContent
