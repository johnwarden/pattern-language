def SyntaxNode type Name(String,Bool) | NumberLiteral(Float) | StringLiteral(String) | Apply(SyntaxNode,(type Field(String,SyntaxNode))*) | Pack((type Field(String,SyntaxNode))*) | Quote(SyntaxNode) | TypedQuote(SyntaxNode,SyntaxNode,Bool) | TextTemplate((type Text(String) | Hole(SyntaxNode,Int,String))*) | ReaderQuote(SyntaxNode,(type Text(String) | Hole(SyntaxNode,Int,String))*) | Sequence(SyntaxNode*) | Block(SyntaxNode*) | Form(String,SyntaxNode*,(type Capture(String,Bool,(type Field(String,SyntaxNode))*))*)
def Rule type Rule(name: String,kind: Symbol,pattern: SyntaxNode*)
def Reader type Reader(name: String,contract: String)
def BlockPolicy type BlockPolicy(programTail: Symbol,replTail: Symbol,arms: Symbol)
def Language Facet(type Language(start: Symbol,rules: Rule*,readers: Reader*,blocks: BlockPolicy,typeGrammar: SyntaxNode))
type Language
