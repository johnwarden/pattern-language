def SyntaxNode type Name(String,Bool) | NumberLiteral(Float) | StringLiteral(String) | Apply(SyntaxNode,[_... :: (type Field(String,SyntaxNode))*]) | Pack([_... :: (type Field(String,SyntaxNode))*]) | Postfix(String,SyntaxNode) | Quote(SyntaxNode) | TypedQuote(SyntaxNode,SyntaxNode,Bool) | TextTemplate([_... :: (type Text(String) | Hole(SyntaxNode,Int,String))*]) | ReaderQuote(SyntaxNode,[_... :: (type Text(String) | Hole(SyntaxNode,Int,String))*]) | Sequence([_... :: SyntaxNode*]) | Block([_... :: SyntaxNode*]) | Form(String,[_... :: SyntaxNode*],[_... :: (type Capture(String,Bool,[_... :: (type Field(String,SyntaxNode))*]))*])
def Rule type Rule(name: String,kind: Symbol,pattern: [_... :: SyntaxNode*])
def Reader type Reader(name: String,contract: String)
def BlockPolicy type BlockPolicy(programTail: Symbol,replTail: Symbol,arms: Symbol)
def Language Facet(type Language(start: Symbol,rules: [_... :: Rule*],readers: [_... :: Reader*],blocks: BlockPolicy,typeGrammar: SyntaxNode))
type Language
